  return res.json();
}
function errorMessage(err) {
  if (err instanceof Error) {
    if (err.name === "TimeoutError") return `timed out: ${err.message}`;
    const cause = err.cause;
    return cause instanceof Error ? `${err.message} (${cause.message})` : err.message;
  }
  return String(err);
}

// src/lib/signals/epss.ts
var EPSS_API_URL = "https://api.first.org/data/v1/epss";
var EPSS_BATCH_SIZE = 100;
var EPSS_TIMEOUT_MS = 3e4;
var Probability = external_exports.union([external_exports.string().trim().min(1), external_exports.number()]).transform((v) => typeof v === "string" ? Number(v) : v).pipe(external_exports.number().min(0).max(1));
var EpssEntrySchema = external_exports.object({
  cve: external_exports.string().trim().toUpperCase(),
  epss: Probability,
  percentile: Probability,
  date: external_exports.string().nullish()
});
var EpssResponseSchema = external_exports.object({
  data: external_exports.array(EpssEntrySchema)
});
function parseEpssResponse(json2) {
  const parsed = EpssResponseSchema.safeParse(json2);
  if (!parsed.success) {
    const issues = parsed.error.issues.slice(0, 5).map((i) => `${i.path.map(String).join(".") || "(root)"}: ${i.message}`);
    throw new Error(`EPSS response failed validation: ${issues.join("; ")}`);
  }
  return new Map(parsed.data.data.map((d) => [d.cve, { epss: d.epss, percentile: d.percentile, date: d.date ?? null }]));
}
function chunk(items, size) {
  const out = [];
  for (let i = 0; i < items.length; i += size) out.push(items.slice(i, i + size));
  return out;
}
function epssUrl(cves) {
  return `${EPSS_API_URL}?cve=${cves.join(",")}`;
}
async function fetchEpssScores(cves, opts = {}) {
  const result2 = { scores: /* @__PURE__ */ new Map(), failedCves: /* @__PURE__ */ new Set(), errors: [], date: null };
  const batches = chunk(normalizeCves(cves), opts.batchSize ?? EPSS_BATCH_SIZE);
  for (const [i, batch] of batches.entries()) {
    opts.onBatch?.(i, batches.length);
    try {
      const json2 = await fetchJson(epssUrl(batch), { fetchFn: opts.fetchFn, signal: opts.signal, timeoutMs: opts.timeoutMs ?? EPSS_TIMEOUT_MS });
      for (const [cve, score] of parseEpssResponse(json2)) {
        result2.scores.set(cve, score);
        if (score.date && (result2.date === null || score.date > result2.date)) result2.date = score.date;
      }
    } catch (err) {
      if (opts.signal?.aborted) throw err;
      for (const cve of batch) result2.failedCves.add(cve);
      result2.errors.push(`batch ${i + 1}/${batches.length}: ${errorMessage(err)}`);
    }
  }
  return result2;
}
function maxEpss(cves, scores) {
  let best = null;
  for (const cve of cves) {
    const s = scores.get(cve);
    if (s && (best === null || s.epss > best.epss)) best = s;
  }
  return best ? { epss: best.epss, percentile: best.percentile } : null;
}

// src/lib/signals/escalation.ts
function crossedUp(before, after, threshold) {
  return after !== null && after >= threshold && (before === null || before < threshold);
}
function detectEscalation(from, to, t) {
  const triggers = [];
  if (from.priority && to.priority && priorityRank(to.priority) < priorityRank(from.priority)) {
    triggers.push(`priority ${from.priority} → ${to.priority}`);
  }
  if (!from.inKev && to.inKev) triggers.push("added to CISA KEV");
  const crossed = [t.epss_high, t.epss_medium].find((threshold) => crossedUp(from.epss, to.epss, threshold));
  if (crossed !== void 0 && to.epss !== null) {
    const marks = epssMarks(t);
    const before = from.epss === null ? "none" : formatAgainst(from.epss, marks);
    triggers.push(`EPSS crossed ${crossed} (${before} → ${formatAgainst(to.epss, marks)})`);
  }
  return triggers;
}

// src/lib/signals/kev-feed.ts
var KEV_FEED_URL = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json";
var KEV_TIMEOUT_MS = 6e4;
var optionalText = external_exports.string().nullish();
var KevEntrySchema = external_exports.object({
  cveID: external_exports.string().trim().toUpperCase().regex(CVE_ID_RE),
  vendorProject: optionalText,
  product: optionalText,
  vulnerabilityName: optionalText,
  dateAdded: external_exports.string().regex(/^\d{4}-\d{2}-\d{2}/),
  shortDescription: optionalText,
  requiredAction: optionalText,
  dueDate: optionalText,
  knownRansomwareCampaignUse: optionalText
});
var KevFeedSchema = external_exports.object({
  catalogVersion: external_exports.string(),
  dateReleased: external_exports.string(),
  count: external_exports.number().int().nonnegative(),
  // An empty catalog would wipe every KEV flag on the next enrich; treat it as a broken download.
  vulnerabilities: external_exports.array(KevEntrySchema).min(1)
});
function parseKevFeed(json2) {
  const parsed = KevFeedSchema.safeParse(json2);
  if (!parsed.success) {
    const issues = parsed.error.issues.slice(0, 5).map((i) => `${i.path.map(String).join(".") || "(root)"}: ${i.message}`);
    throw new Error(`KEV feed failed validation:
  ${issues.join("\n  ")}`);
  }
  return parsed.data;
}
function kevRowsFromFeed(feed) {
  const byCve = /* @__PURE__ */ new Map();
  for (const v of feed.vulnerabilities) {
    const row = {
      cve: v.cveID,
      dateAdded: v.dateAdded,
      dueDate: v.dueDate ?? null,
      ransomware: v.knownRansomwareCampaignUse ?? null,
      vendor: v.vendorProject ?? null,
      product: v.product ?? null,
      name: v.vulnerabilityName ?? null,
      shortDescription: v.shortDescription ?? null
    };
    const existing = byCve.get(row.cve);
    if (!existing || (row.dateAdded ?? "") < (existing.dateAdded ?? "")) byCve.set(row.cve, row);
  }
  return [...byCve.values()];
}
async function fetchKevFeed(opts = {}) {
  const json2 = await fetchJson(KEV_FEED_URL, { ...opts, timeoutMs: KEV_TIMEOUT_MS });
  return parseKevFeed(json2);
}
function matchKev(cves, index) {
  let inKev = false;
  let dateAdded = null;
  for (const cve of cves) {
    if (!index.has(cve)) continue;
    inKev = true;
    const d = index.get(cve) ?? null;
    if (d && (dateAdded === null || d < dateAdded)) dateAdded = d;
  }
  return { inKev, dateAdded };
}

// src/lib/signals/compute.ts
function resolveFindingEpss(cves, stored, epss) {
  const scored = cves.filter((c) => !epss.failedCves.has(c));
  const fresh = maxEpss(scored, epss.scores);
  if (scored.length === cves.length) return { epss: fresh?.epss ?? null, epssPercentile: fresh?.percentile ?? null };
  if (fresh && (stored.epss === null || fresh.epss > stored.epss)) return { epss: fresh.epss, epssPercentile: fresh.percentile };
  return { epss: stored.epss, epssPercentile: stored.epssPercentile };
}
function computeFindingSignals(row, src) {
  const cves = normalizeCves(row.advisory?.cves ?? []);
  const malicious = (row.advisory?.malicious ?? false) || row.osvId.startsWith("MAL-");
  const kevMatch = matchKev(cves, src.kevIndex);
  const { epss, epssPercentile } = resolveFindingEpss(cves, row, src.epss);
  const cvssScore = resolveCvssScore(row.advisory);
  const { priority, reasons } = computeBasePriority(
    {
      osvId: row.osvId,
      malicious,
      inKev: kevMatch.inKev,
      kevDateAdded: kevMatch.dateAdded,
      epss,
      cvss: cvssScore,
      exposure: row.exposure,
      criticality: row.criticality
    },
    src.thresholds
  );
  const escalation = row.enrichedAt === null ? [] : detectEscalation(
    { priority: row.priority, inKev: row.inKev, epss: row.epss },
    { priority, inKev: kevMatch.inKev, epss },
    src.thresholds
  );
  return {
    cves,
    malicious,
    inKev: kevMatch.inKev,
    kevDateAdded: kevMatch.dateAdded,
    epss,
    epssPercentile,
    cvssScore,
    priority,
    priorityReasons: reasons,
    escalation
  };
}

// src/plugin/kev-cache.ts
var import_node_fs13 = require("node:fs");
var KEV_MAX_AGE_HOURS = 24;
var CACHE_FORMAT = 1;
function readCache(file2) {
  let text;
  try {
    text = (0, import_node_fs13.readFileSync)(file2, "utf8");
  } catch (err) {
    if (err.code === "ENOENT") return { cache: null, problem: null };
    return { cache: null, problem: errorMessage(err) };
  }
  try {
    const raw = JSON.parse(text);
    if (raw.format !== CACHE_FORMAT || typeof raw.fetchedAt !== "string") throw new Error("unknown format");
    return { cache: { format: CACHE_FORMAT, fetchedAt: raw.fetchedAt, feed: parseKevFeed(raw.feed) }, problem: null };
  } catch (err) {
    return { cache: null, problem: errorMessage(err).split("\n")[0] };
  }
}
function kevIndexFromFeed(feed) {
  return new Map(kevRowsFromFeed(feed).map((r) => [r.cve, { dateAdded: r.dateAdded ?? null, ransomware: r.ransomware ?? null }]));
}
function kevDateIndex(index) {
  return new Map([...index].map(([cve, e]) => [cve, e.dateAdded]));
}
function kevRansomwareFor(cves, index) {
  for (const cve of [...cves].sort()) {
    const entry = index.get(cve);
    if (entry) return entry.ransomware;
  }
  return null;
}
function result(cache, warnings, fetched) {
  return { index: kevIndexFromFeed(cache.feed), catalogDate: cache.feed.dateReleased, warnings, available: true, fetched };
}
async function loadKev(opts) {
  const now = opts.now ?? (() => /* @__PURE__ */ new Date());
  const maxAgeMs = (opts.maxAgeHours ?? KEV_MAX_AGE_HOURS) * 36e5;
  const warnings = [];
  const { cache, problem } = readCache(opts.kevFile);
  if (problem) warnings.push(`ignoring the cached KEV catalog ${opts.kevFile} (${problem})`);
  const fetchedAt = cache ? Date.parse(cache.fetchedAt) : NaN;
  if (cache && !opts.force && Number.isFinite(fetchedAt) && now().getTime() - fetchedAt < maxAgeMs) {
    return result(cache, warnings, false);
  }
  try {
    const feed = await fetchKevFeed({ fetchFn: opts.fetchFn, signal: opts.signal });
    const fresh = { format: CACHE_FORMAT, fetchedAt: now().toISOString(), feed };
    writeFileAtomic(opts.kevFile, `${JSON.stringify(fresh)}
`);
    return result(fresh, warnings, true);
  } catch (err) {
    if (opts.signal?.aborted) throw err;
    const message2 = errorMessage(err).split("\n")[0];
    if (cache) {
      warnings.push(
        `CISA KEV catalog could not be refreshed (${message2}); using the copy released ${cache.feed.dateReleased.slice(0, 10)}`
      );
      return result(cache, warnings, false);
    }
    warnings.push(
      `CISA KEV catalog unavailable (${message2}): no finding could be checked against known-exploited vulnerabilities, so findings that belong in P0/P1 may be ranked lower. Re-run when the network is back.`
    );
    return { index: /* @__PURE__ */ new Map(), catalogDate: null, warnings, available: false, fetched: false };
  }
}


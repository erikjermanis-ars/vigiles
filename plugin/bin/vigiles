    "data_classes: [TODO]",
    "# How it runs. Free-form keys: add what matters (platform, build, runtime versions pinned outside lockfiles).",
    "runtime:",
    `  language: ${q(facts.languages.join(", ") || "TODO")}`,
    facts.nodeVersion ? `  node: ${q(facts.nodeVersion)}` : '  # node: "22"',
    `  frameworks: ${list(frameworks)}`,
    "# One entry per deployed component: what runs, where and how, and who can reach it. Free-form keys.",
    "deployments:",
    "  - env: production",
    `    component: ${q("TODO: what runs (e.g. web app with SSR, REST API, static site, background worker)")}`,
    `    hosting: ${q("TODO: where and how (e.g. AWS ECS container, Vercel, static files on S3 + CloudFront)")}`,
    `    public: ${q("TODO: reachable from the internet? by whom (anonymous visitors, signed-in users, staff)?")}`,
    "# External services the code talks to, e.g. [supabase, stripe, aws-s3, sentry].",
    "third_party_services: []",
    "# What limits an attacker: authentication (who can sign up, what sits behind login), WAF/CDN/rate limits,",
    '# request body and upload size limits, sandboxing. Write "none known" rather than leaving it empty.',
    "mitigations: >",
    "  TODO",
    "# Anything else that changes whether a vulnerable package matters here: packages that are build-only, dev-only",
    "# or never imported; code that runs only in development or QA; what dependency matching does not cover.",
    "notes: >",
    "  TODO",
    ""
  ];
  return lines.join("\n");
}
function formatFacts(facts) {
  const lines = [`repository: ${facts.repoRoot}`];
  if (!facts.head) {
    lines.push("HEAD: no commit yet");
    return lines.join("\n");
  }
  lines.push(`HEAD: ${facts.head.commit} (${facts.currentBranch ?? "detached"}, ${facts.head.date})`);
  lines.push(`default branch: ${facts.defaultBranch ?? "unknown"}`);
  for (const r of facts.remotes) lines.push(`remote ${r.name}: ${r.url}`);
  lines.push(`lockfiles: ${facts.lockfiles.map((l) => `${l.file} (${l.ecosystem})`).join(", ") || "none"}`);
  if (facts.coverageGaps.length) lines.push(`manifests without a lockfile: ${facts.coverageGaps.join(", ")}`);
  lines.push(`languages: ${facts.languages.join(", ") || "unknown"}`);
  if (facts.nodeVersion) lines.push(`node: ${facts.nodeVersion}`);
  for (const f of facts.frameworks) lines.push(`${f.manifest}: ${f.packages.join(", ")}`);
  if (facts.infraFiles.length) {
    const more = facts.infraFilesTotal > facts.infraFiles.length ? ` (+${facts.infraFilesTotal - facts.infraFiles.length} more)` : "";
    lines.push(`deployment/CI/infra files: ${facts.infraFiles.join(", ")}${more}`);
  }
  return lines.map(oneLine3).join("\n");
}

// src/plugin/report.ts
var ACTION_ORDER = ["ping", "digest", "log"];
var MAX_EVIDENCE = 5;
var MAX_TITLE = 120;
var MAX_HEADING_PACKAGES = 3;
var SUMMARY_ITEMS = 15;
function cmp(a, b) {
  return a < b ? -1 : a > b ? 1 : 0;
}
function descNullsLast2(a, b) {
  if (a === b) return 0;
  if (a === null) return 1;
  if (b === null) return -1;
  return b - a;
}
function rank(p) {
  return PRIORITIES.indexOf(p);
}
function collapse(s) {
  return (s ?? "").replace(/\s+/g, " ").trim();
}
function inline(s) {
  return collapse(s).replace(/\\/g, "\\\\").replace(/[[\]]/g, (c) => `\\${c}`).replace(/<(?=[A-Za-z/!?])/g, "\\<");
}
function cell(s) {
  return inline(s).replace(/\|/g, "\\|");
}
function code(s) {
  const text = collapse(s);
  const longest = Math.max(0, ...(text.match(/`+/g) ?? []).map((run) => run.length));
  if (!longest) return `\`${text}\``;
  const fence = "`".repeat(longest + 1);
  return `${fence} ${text} ${fence}`;
}
function truncate2(s, max) {
  return s.length > max ? `${s.slice(0, max - 1).trimEnd()}…` : s;
}
function firstSentence(s, max = 160) {
  const text = collapse(s);
  const m = /^.*?[.!?](?=\s|$)/.exec(text);
  return truncate2(m ? m[0] : text, max);
}
function plural2(n, one, many = `${one}s`) {
  return `${n.toLocaleString("en-US")} ${n === 1 ? one : many}`;
}
function label(v) {
  return v.replace(/_/g, " ");
}
function epssLabel(epss) {
  const pct = epss * 100;
  if (pct >= 1) return `${Math.round(pct)}%`;
  if (pct >= 0.1) return `${pct.toFixed(1)}%`;
  return "<0.1%";
}
function shortSha(sha) {
  return sha.slice(0, 7);
}
function isTriaged(d) {
  return d.triageStatus === "ok" || d.triageStatus === "skipped";
}
function compareMembers(a, b) {
  return Number(a.ruleId === SAME_ADVISORY_RULE) - Number(b.ruleId === SAME_ADVISORY_RULE) || Number(!isTriaged(a)) - Number(!isTriaged(b)) || rank(a.inputs.priority ?? a.finding.priority) - rank(b.inputs.priority ?? b.finding.priority) || descNullsLast2(a.finding.cvssScore, b.finding.cvssScore) || cmp(a.finding.packageName, b.finding.packageName);
}
function firstName(item) {
  return [...item.members].map((m) => m.finding.packageName).sort(cmp)[0] ?? "";
}
function compareItems(a, b) {
  return ACTION_ORDER.indexOf(a.action) - ACTION_ORDER.indexOf(b.action) || rank(a.priority) - rank(b.priority) || Number(!a.lead.inputs.malicious) - Number(!b.lead.inputs.malicious) || descNullsLast2(a.cvss, b.cvss) || cmp(firstName(a), firstName(b)) || cmp(a.osvId, b.osvId) || cmp(a.lockfile, b.lockfile);
}
function reportItems(decisions) {
  const groups = /* @__PURE__ */ new Map();
  for (const d of decisions.findings) {
    const key = `${d.action}\0${d.finding.lockfile}\0${d.finding.osvId}`;
    const g = groups.get(key);
    if (g) g.push(d);
    else groups.set(key, [d]);
  }
  const items = [];
  for (const members2 of groups.values()) {
    members2.sort(compareMembers);
    const lead = members2[0];
    const priority = members2.map((m) => m.inputs.priority ?? m.finding.priority).sort((a, b) => rank(a) - rank(b))[0];
    const scores = members2.map((m) => m.finding.cvssScore).filter((x) => x !== null);
    items.push({
      action: lead.action,
      lockfile: lead.finding.lockfile,
      osvId: lead.finding.osvId,
      members: members2,
      lead,
      priority,
      cvss: scores.length ? Math.max(...scores) : null
    });
  }
  return items.sort(compareItems);
}
function packageLabel2(f) {
  return `${f.packageName}@${f.installedVersions.join(", ") || "?"}`;
}
function packagesLabel(item, max = MAX_HEADING_PACKAGES) {
  const names = item.members.map((m) => packageLabel2(m.finding));
  if (names.length <= max) return names.join(", ");
  return `${names.slice(0, max).join(", ")} and ${names.length - max} more`;
}
function cvesOf(d) {
  const cves = d.advisory?.cves.length ? d.advisory.cves : d.finding.cves;
  return cves.filter((c) => c !== d.finding.osvId);
}
function displayId(d) {
  return cvesOf(d)[0] ?? d.finding.osvId;
}
function titleOf(item) {
  const summary = collapse(item.lead.advisory?.summary);
  return summary ? truncate2(summary, MAX_TITLE) : item.osvId;
}
function plainItemTitle(item) {
  return `${packagesLabel(item)} — ${titleOf(item)}`;
}
function itemTitle(item) {
  return inline(plainItemTitle(item));
}
function signalsLabel(d) {
  const f = d.finding;
  const parts = [d.inputs.priority ?? f.priority];
  if (d.inputs.malicious) parts.push("malicious package");
  if (f.cvssScore !== null) parts.push(`CVSS ${f.cvssScore.toFixed(1)}`);
  if (f.inKev) {
    const since = f.kevDateAdded ? `, since ${shortDate(f.kevDateAdded, "UTC")}` : "";
    const ransomware = f.kevRansomware === "Known" ? ", used in ransomware campaigns" : "";
    parts.push(`exploited in the wild (CISA KEV${since}${ransomware})`);
  }
  if (f.epss !== null) parts.push(`EPSS ${epssLabel(f.epss)}`);
  return parts.join(" · ");
}
function dependencyLabel(f) {
  const kind = f.direct === null ? "direct or transitive (unknown)" : f.direct ? "direct" : "transitive";
  const scope = f.devOnly ? ", dev only" : "";
  const chain = f.paths.find((p) => p.length > 1);
  if (!chain) return `${kind}${scope}`;
  return f.direct ? `${kind}${scope} (also via ${code(chain.join(" > "))})` : `${kind}${scope} via ${code(chain.join(" > "))}`;
}
function fixedLabel(f) {
  return f.fixedVersions.length ? `Fixed in ${f.fixedVersions.join(", ")}.` : "No fixed version is published yet.";
}
function untriagedReason(d) {
  const where = ACTION_LABELS[d.action];
  const reasons = d.finding.priorityReasons.length ? ` (${d.finding.priorityReasons.map(inline).join("; ")})` : "";
  const signals = `It is in ${where} because of its signals alone: ${d.inputs.priority ?? d.finding.priority}${reasons}.`;
  const lead = d.triageStatus === "failed" ? `Triage failed (${inline(truncate2(collapse(d.failure), 160))}), so there is no verdict yet.` : "Not triaged yet, so there is no verdict.";
  return `${lead} ${signals} Run ${code("/vigiles:audit")} again to triage it.`;
}
function otherMembersLine(item) {
  const others = item.members.slice(1);
  if (!others.length) return null;
  const parts = others.map((m) => {
    const v = m.verdict?.output;
    const state = v ? `${label(v.verdict)}, ${v.confidence} confidence` : m.triageStatus === "failed" ? "triage failed" : m.triageStatus === "pending" ? "not triaged yet" : "malicious";
    const raised = m.ruleId === SAME_ADVISORY_RULE ? "; raised to match" : "";
    return `${code(packageLabel2(m.finding))} (${state}${raised})`;
  });
  return `- **Same advisory, also in:** ${parts.join(", ")}. One fix usually covers all of them.`;
}
function renderItem(item, scan2) {
  const d = item.lead;
  const f = d.finding;
  const ids = [`[${inline(f.osvId)}](${osvUrl(f.osvId)})`, ...cvesOf(d).map(inline)].join(" · ");
  const lines = [`### ${itemTitle(item)}`, "", `${ids} · ${code(item.lockfile)}`, ""];
  const v = d.verdict?.output;
  if (d.inputs.malicious) {
    lines.push(
      "- **Why:** This package version is known malware. Installing it can run attacker code on developer machines and in CI.",
      `- **Signals:** ${signalsLabel(d)}. No AI triage needed: malicious packages always go to Fix now.`,
      `- **Fix:** ${MALICIOUS_REMEDIATION}`
    );
  } else if (v) {
    lines.push(`- **Why:** ${inline(v.suggested_action_reason)}`);
    lines.push(`- **Verdict:** ${label(v.verdict)}, ${v.confidence} confidence · ${signalsLabel(d)}`);
    if (v.suggested_action !== d.action) {
      lines.push(
        `- **Placement:** the AI suggested ${ACTION_LABELS[v.suggested_action]}; policy rule ${code(d.ruleId)} puts it in ${ACTION_LABELS[d.action]}.`
      );
    }
    if (v.summary.trim()) lines.push(`- **Summary:** ${inline(v.summary)}`);
    if (v.exploit_conditions.trim()) lines.push(`- **Exploitable when:** ${inline(v.exploit_conditions)}`);
    if (v.evidence.length) {
      const asOf = d.verdict && d.verdict.commit !== scan2.commit ? ` (as of ${code(shortSha(d.verdict.commit))})` : "";
      lines.push(`- **Where in the code${asOf}:**`);
      for (const e of v.evidence.slice(0, MAX_EVIDENCE)) {
        lines.push(`  - ${code(e.line === null ? e.file : `${e.file}:${e.line}`)}${e.note.trim() ? ` — ${inline(e.note)}` : ""}`);
      }
      if (v.evidence.length > MAX_EVIDENCE) lines.push(`  - and ${v.evidence.length - MAX_EVIDENCE} more`);
    }
    const namesFix = f.fixedVersions.some((x) => v.remediation.includes(x));
    const fix = [inline(v.remediation), namesFix ? "" : fixedLabel(f), v.workaround?.trim() ? `Workaround: ${inline(v.workaround)}` : ""].filter(Boolean).join(" ");
    lines.push(`- **Fix:** ${fix}`);
  } else {
    lines.push(`- **Why:** ${untriagedReason(d)}`);
    lines.push(`- **Signals:** ${signalsLabel(d)}`);
    lines.push(`- **Fix:** ${fixedLabel(f)}`);
  }
  lines.push(`- **Dependency:** ${dependencyLabel(f)}`);
  const others = otherMembersLine(item);
  if (others) lines.push(others);
  lines.push("");
  return lines;
}
function refLabel(scan2) {
  if (scan2.branch) return code(scan2.branch);
  return scan2.ref === "HEAD" ? "detached HEAD" : code(scan2.ref);
}
function mentions(texts, needle) {
  return texts.some((t) => typeof needle === "string" ? t.includes(needle) : needle.test(t));
}
function reportWarnings(scan2, decisions, extra = []) {
  const own2 = [...scan2.warnings, ...extra];
  const out = [];
  const unc = scan2.uncommittedDependencyFiles;
  if (unc.length && !mentions(own2, unc[0])) {
    out.push(
      `Not audited: uncommitted changes in ${unc.map(code).join(", ")}. This audit read the committed state; commit them and run again to include them.`
    );
  }
  const gaps = scan2.coverageGaps.filter((g) => !scan2.skippedLockfiles.includes(g) && !mentions(own2, g));
  if (gaps.length) {
    out.push(`No lockfile, so their dependencies were not audited: ${gaps.map(code).join(", ")}.`);
  }
  const skipped = scan2.skippedLockfiles.filter((l) => !mentions(own2, l));
  if (skipped.length) out.push(`Skipped (could not be read): ${skipped.map(code).join(", ")}.`);
  if (!scan2.data.kevAvailable && !mentions(own2, /KEV/)) {
    out.push("The CISA KEV catalog was unavailable: exploited-in-the-wild flags are missing, so some items may be ranked too low.");
  }
  if (scan2.data.epssFailedCves > 0 && !mentions(own2, /EPSS/)) {
    out.push(`EPSS scores could not be fetched for ${plural2(scan2.data.epssFailedCves, "CVE")}; their priority may be too low.`);
  }
  out.push(...own2);
  const failed = decisions.findings.filter((d) => d.triageStatus === "failed").length;
  const pending = decisions.findings.filter((d) => d.triageStatus === "pending").length;
  if (failed + pending) {
    const parts = [...failed ? [`${failed} failed`] : [], ...pending ? [`${pending} not triaged yet`] : []].join(", ");
    out.push(
      `${plural2(failed + pending, "finding")} without a verdict (${parts}): placed by their signals alone. See Not triaged; run ${code("/vigiles:audit")} again to triage them.`
    );
  }
  return [...new Set(out)];
}
function hasUntriaged(item) {
  return item.members.some((m) => m.triageStatus === "pending" || m.triageStatus === "failed");
}
function counts(items) {
  const n = (a) => items.filter((i) => i.action === a).length;
  const main2 = ACTION_ORDER.map((a) => `${ACTION_LABELS[a]} ${n(a)}`).join(" · ");
  const untriaged = items.filter(hasUntriaged).length;
  return { main: main2, untriaged: untriaged ? `${untriaged} of these ${plural2(items.length, "item")} not triaged yet` : null };
}
function countsLine(items) {
  const { main: main2, untriaged } = counts(items);
  return untriaged ? `**${main2}** (${untriaged}; placed by their signals)` : `**${main2}**`;
}
function whyLogged(d) {
  const v = d.verdict?.output;
  if (v) return `${label(v.verdict)}: ${firstSentence(v.suggested_action_reason)}`;
  return d.triageStatus === "failed" ? "triage failed; placed by its signals" : "not triaged yet; placed by its signals";
}
function loggedSummary(items) {
  const untriaged = items.filter((i) => !isTriaged(i.lead)).length;
  if (!untriaged) return `${plural2(items.length, "item")} judged not a real threat in this project`;
  return `${plural2(items.length, "item")} with no action needed (${untriaged} of them not triaged yet, placed here by their signals)`;
}
function multiLockfile(decisions) {
  return new Set(decisions.findings.map((d) => d.finding.lockfile)).size > 1;
}
function loggedSection(items, showLockfile) {
  const lines = [`## ${ACTION_LABELS.log} (${items.length})`, ""];
  if (!items.length) return [...lines, "None.", ""];
  const lockCol = showLockfile ? " Lockfile |" : "";
  lines.push(
    "<details>",
    `<summary>${loggedSummary(items)}</summary>`,
    "",
    `| Package |${lockCol} Advisory | Priority | Why |`,
    `|---|${showLockfile ? "---|" : ""}---|---|---|`
  );
  for (const item of items) {
    const lock = showLockfile ? ` ${cell(item.lockfile)} |` : "";
    lines.push(
      `| ${cell(packagesLabel(item, Infinity))} |${lock} ${cell(displayId(item.lead))} | ${item.priority} | ${cell(whyLogged(item.lead))} |`
    );
  }
  lines.push("", "</details>", "");
  return lines;
}
function notTriagedSection(decisions, showLockfile) {
  const rows = decisions.findings.filter((d) => d.triageStatus === "pending" || d.triageStatus === "failed").sort(
    (a, b) => ACTION_ORDER.indexOf(a.action) - ACTION_ORDER.indexOf(b.action) || rank(a.inputs.priority ?? a.finding.priority) - rank(b.inputs.priority ?? b.finding.priority) || descNullsLast2(a.finding.cvssScore, b.finding.cvssScore) || cmp(a.finding.packageName, b.finding.packageName) || cmp(a.finding.id, b.finding.id)
  );
  if (!rows.length) return [];
  const failed = rows.filter((d) => d.triageStatus === "failed").length;
  const pending = rows.length - failed;
  const parts = [...failed ? [`${failed} failed`] : [], ...pending ? [`${pending} not triaged yet`] : []].join(", ");
  const lines = [
    `## Not triaged (${rows.length})`,
    "",
    `No verdict yet, so these findings are placed by their signals alone; each is also shown in its section above. Run ${code("/vigiles:audit")} again to triage them.`,
    "",
    "<details>",
    `<summary>${parts}</summary>`,
    "",
    `| Package |${showLockfile ? " Lockfile |" : ""} Advisory | Priority | Placed in | Status |`,
    `|---|${showLockfile ? "---|" : ""}---|---|---|---|`
  ];
  for (const d of rows) {
    const status = d.triageStatus === "failed" ? `failed: ${truncate2(collapse(d.failure), 160)}` : "not triaged yet";
    const lock = showLockfile ? ` ${cell(d.finding.lockfile)} |` : "";
    lines.push(
      `| ${cell(packageLabel2(d.finding))} |${lock} ${cell(displayId(d))} | ${d.inputs.priority ?? d.finding.priority} | ${ACTION_LABELS[d.action]} | ${cell(status)} |`
    );
  }
  lines.push("", "</details>", "");
  return lines;
}
function dateOrUnavailable(d) {
  return d ? shortDate(d, "UTC") : "unavailable";
}
function renderReport(opts) {
  const { scan: scan2, decisions, profile } = opts;
  const items = reportItems(decisions);
  const byAction = (a) => items.filter((i) => i.action === a);
  const committed = scan2.commitDate ? ` (committed ${shortDate(scan2.commitDate, opts.timeZone)})` : "";
  const lines = [
    `# Dependency audit: ${inline(profile.name)}`,
    "",
    [
      `Audited ${refLabel(scan2)} at ${code(shortSha(scan2.commit))}${committed}`,
      plural2(scan2.lockfiles.length, "lockfile"),
      plural2(scan2.stats.packages, "package"),
      `generated ${formatDateTime(opts.generatedAt, opts.timeZone)}`
    ].join(" · "),
    "",
    countsLine(items),
    "",
    `**${ACTION_LABELS.ping}**: real harm is possible soon; fix today. **${ACTION_LABELS.digest}**: real but not urgent; fix within 1–2 weeks. **${ACTION_LABELS.log}**: not a real threat in this project; no action needed.`,
    ""
  ];
  const warnings = reportWarnings(scan2, decisions, opts.warnings);
  if (warnings.length) {
    lines.push("## Warnings", "", ...warnings.map((w) => `- ${inline(w)}`), "");
  }
  if (!decisions.findings.length) {
    lines.push("No known vulnerabilities in the audited lockfiles.", "");
  } else {
    for (const action of ["ping", "digest"]) {
      const section = byAction(action);
      lines.push(`## ${ACTION_LABELS[action]} (${section.length})`, "");
      if (!section.length) lines.push("None.", "");
      for (const item of section) lines.push(...renderItem(item, scan2));
    }
    const showLockfile = multiLockfile(decisions);
    lines.push(...loggedSection(byAction("log"), showLockfile));
    lines.push(...notTriagedSection(decisions, showLockfile));
  }
  const tc = scan2.triageConfig;
  lines.push(
    "---",
    "",
    `Data: OSV database ${dateOrUnavailable(scan2.data.osvDbDate)} · CISA KEV ${dateOrUnavailable(scan2.data.kevCatalogDate)} · EPSS ${dateOrUnavailable(scan2.data.epssDate)}. Triage: ${tc.name} (prompt ${tc.promptFingerprint}). Policy ${decisions.policyHash}. Vigiles ${opts.toolVersion}.`,
    "",
    `Commit the ${code(".vigiles/")} directory (this report is gitignored) so teammates reuse these verdicts.`,
    ""
  );
  return lines.join("\n");
}
function renderSummary(decisions, scan2, reportFile) {
  const items = reportItems(decisions);
  const { main: main2, untriaged } = counts(items);
  const showLockfile = multiLockfile(decisions);
  const lines = [`${main2} (${refLabel(scan2).replace(/`/g, "")} @ ${shortSha(scan2.commit)})${untriaged ? `; ${untriaged}` : ""}`];
  for (const action of ["ping", "digest"]) {
    const section = items.filter((i) => i.action === action);
    if (!section.length) continue;
    lines.push(`${ACTION_LABELS[action]}:`);
    for (const item of section.slice(0, SUMMARY_ITEMS)) {
      const id = displayId(item.lead);
      const where = showLockfile ? ` in ${item.lockfile}` : "";
      lines.push(`  - ${plainItemTitle(item)} (${id})${where}${hasUntriaged(item) ? " [not triaged]" : ""}`);
    }
    if (section.length > SUMMARY_ITEMS) lines.push(`  - … and ${section.length - SUMMARY_ITEMS} more in the report`);
  }
  if (reportFile) lines.push(`Report: ${reportFile}`);
  return lines.join("\n");
}


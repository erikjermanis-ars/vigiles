  package: external_exports.looseObject({ ecosystem: external_exports.string().optional(), name: external_exports.string().optional() }).optional(),
  ranges: external_exports.array(external_exports.looseObject({ type: external_exports.string().optional(), events: external_exports.array(external_exports.record(external_exports.string(), external_exports.unknown())).default([]) })).optional(),
  versions: external_exports.array(external_exports.string()).optional()
});
var OsvRecordSchema = external_exports.looseObject({

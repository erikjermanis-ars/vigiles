// src/lib/osv/zip.ts
var import_node_fs9 = require("node:fs");
var import_node_path11 = __toESM(require("node:path"), 1);
var import_node_stream = require("node:stream");
var import_promises = require("node:stream/promises");
var DOWNLOAD_TIMEOUT_MS = 15 * 6e4;
var USER_AGENT = "vigiles-poc";
function assertEcosystemName(ecosystem) {
  if (!/^[A-Za-z0-9][A-Za-z0-9.:_ +-]*$/.test(ecosystem) || ecosystem.split(".").some((p) => p === "")) {
    throw new Error(`invalid OSV ecosystem name "${ecosystem}"`);
  }
}
function osvZipPath(osvDbDir, ecosystem) {
  assertEcosystemName(ecosystem);
  return import_node_path11.default.join(osvDbDir, "osv-scalibr", ecosystem, "all.zip");
}
var OsvDatabaseUnavailableError = class extends Error {
  constructor(ecosystem) {
    super(`OSV has no offline database for ecosystem "${ecosystem}"`);
    this.ecosystem = ecosystem;
  }
  ecosystem;
};
function errorText(err) {
  if (err instanceof Error) {
    if (err.name === "TimeoutError") return `timed out: ${err.message}`;
    const cause = err.cause;
    return cause instanceof Error ? `${err.message} (${cause.message})` : err.message;
  }
  return String(err);
}
function startsWithZipMagic(file2) {
  const fd = (0, import_node_fs9.openSync)(file2, "r");
  try {
    const buf = Buffer.alloc(2);
    return (0, import_node_fs9.readSync)(fd, buf, 0, 2, 0) === 2 && buf.toString("latin1") === "PK";
  } finally {
    (0, import_node_fs9.closeSync)(fd);
  }
}
async function fetchOsvZip(ecosystem, opts, stored) {
  const started = Date.now();
  const target = osvZipPath(opts.osvDbDir, ecosystem);
  const url2 = `${opts.baseUrl.replace(/\/+$/, "")}/${encodeURIComponent(ecosystem)}/all.zip`;
  const tmp = `${target}.tmp-${process.pid}-${Date.now()}`;
  try {
    (0, import_node_fs9.mkdirSync)(import_node_path11.default.dirname(target), { recursive: true, mode: 448 });
    const existing = (0, import_node_fs9.statSync)(target, { throwIfNoEntry: false });
    const headers = { "User-Agent": USER_AGENT };
    if (existing) {
      if (stored.etag) headers["If-None-Match"] = stored.etag;
      headers["If-Modified-Since"] = existing.mtime.toUTCString();
    }
    const timeout = AbortSignal.timeout(opts.timeoutMs ?? DOWNLOAD_TIMEOUT_MS);
    const signal = opts.signal ? AbortSignal.any([opts.signal, timeout]) : timeout;
    const res = await (opts.fetchFn ?? fetch)(url2, { headers, signal });
    let meta3;
    let status;
    if (res.status === 304 && existing) {
      await res.body?.cancel();
      status = "not_modified";
      meta3 = {
        etag: res.headers.get("etag") ?? stored.etag ?? null,
        lastModified: stored.lastModified ?? existing.mtime.toUTCString(),
        bytes: existing.size,
        path: target
      };
    } else if (res.ok && res.body) {
      await (0, import_promises.pipeline)(import_node_stream.Readable.fromWeb(res.body), (0, import_node_fs9.createWriteStream)(tmp, { mode: 384 }));
      const bytes = (0, import_node_fs9.statSync)(tmp).size;
      const expected = res.headers.has("content-encoding") ? NaN : Number(res.headers.get("content-length") ?? NaN);
      if (Number.isFinite(expected) && expected !== bytes) throw new Error(`truncated download: ${bytes} of ${expected} bytes`);
      if (!startsWithZipMagic(tmp)) throw new Error("downloaded file is not a zip");
      const lastModified = res.headers.get("last-modified");
      const mtime = lastModified ? new Date(lastModified) : null;
      if (mtime && !Number.isNaN(mtime.getTime())) (0, import_node_fs9.utimesSync)(tmp, mtime, mtime);
      (0, import_node_fs9.renameSync)(tmp, target);
      status = "downloaded";
      meta3 = { etag: res.headers.get("etag"), lastModified, bytes, path: target };
    } else {
      await res.body?.cancel();
      if (res.status === 404) throw new OsvDatabaseUnavailableError(ecosystem);
      throw new Error(`GET ${url2} → HTTP ${res.status} ${res.statusText}`.trim());
    }
    return { ecosystem, status, durationMs: Date.now() - started, ...meta3 };
  } finally {
    (0, import_node_fs9.rmSync)(tmp, { force: true });
  }
}
function osvDbDate(osvDbDir, ecosystems) {
  let oldest = null;
  for (const eco of ecosystems) {
    const st = (0, import_node_fs9.statSync)(osvZipPath(osvDbDir, eco), { throwIfNoEntry: false });
    if (st && (oldest === null || st.mtimeMs < oldest)) oldest = st.mtimeMs;
  }
  return oldest === null ? null : new Date(oldest).toISOString();
}

// src/plugin/osv-db.ts
var OSV_BASE_URL = "https://osv-vulnerabilities.storage.googleapis.com";
var OSV_MAX_AGE_HOURS = 24;
function sidecarPath(osvDbDir, ecosystem) {
  return `${osvZipPath(osvDbDir, ecosystem)}.meta.json`;
}
function readSidecar(osvDbDir, ecosystem) {
  try {
    const value = JSON.parse((0, import_node_fs10.readFileSync)(sidecarPath(osvDbDir, ecosystem), "utf8"));
    return value && typeof value === "object" ? value : {};
  } catch {
    return {};
  }
}
function writeSidecar(osvDbDir, ecosystem, meta3) {
  writeFileAtomic(sidecarPath(osvDbDir, ecosystem), `${JSON.stringify(meta3, null, 2)}
`);
}
function isFresh(sidecar, now, maxAgeHours) {
  const checked = sidecar.checkedAt ? Date.parse(sidecar.checkedAt) : NaN;
  return Number.isFinite(checked) && now.getTime() - checked < maxAgeHours * 36e5;
}
function mb(bytes) {
  return `${(bytes / 1048576).toFixed(1)} MB`;
}
async function ensureOsvDatabases(ecosystems, opts) {
  const now = opts.now ?? (() => /* @__PURE__ */ new Date());
  const maxAgeHours = opts.maxAgeHours ?? OSV_MAX_AGE_HOURS;
  const log = opts.log ?? (() => {
  });
  const refresh = { baseUrl: opts.baseUrl ?? OSV_BASE_URL, osvDbDir: opts.osvDbDir, signal: opts.signal, fetchFn: opts.fetchFn, now };
  const out = { unavailable: [], downloaded: [], warnings: [], dbDate: null };
  for (const eco of [...new Set(ecosystems)].sort()) {
    assertEcosystemName(eco);
    const zip = osvZipPath(opts.osvDbDir, eco);
    const present = (0, import_node_fs10.existsSync)(zip);
    const sidecar = present ? readSidecar(opts.osvDbDir, eco) : {};
    if (present && !opts.force && isFresh(sidecar, now(), maxAgeHours)) continue;
    if (!present) log(`downloading the OSV ${eco} database (first use; a large ecosystem like npm is about 200 MB)`);
    try {
      const r = await fetchOsvZip(eco, refresh, sidecar);
      writeSidecar(opts.osvDbDir, eco, {
        etag: r.etag,
        lastModified: r.lastModified,
        bytes: r.bytes,
        path: r.path,
        checkedAt: now().toISOString()
      });
      if (r.status === "downloaded") {
        out.downloaded.push(eco);
        log(`OSV ${eco} database ${present ? "updated" : "downloaded"} (${mb(r.bytes)})`);
      }
    } catch (err) {
      if (opts.signal?.aborted) throw err;
      if (err instanceof OsvDatabaseUnavailableError) {
        if (!present) {
          out.unavailable.push(eco);
          continue;
        }
        out.warnings.push(
          `OSV no longer publishes a ${eco} database; using the copy from ${osvDbDate(opts.osvDbDir, [eco])?.slice(0, 10) ?? "an unknown date"}`
        );
        continue;
      }
      if (!present) throw new Error(`OSV ${eco} database could not be downloaded: ${errorText(err)}`, { cause: err });
      out.warnings.push(
        `OSV ${eco} database could not be refreshed (${errorText(err)}); matched against the copy from ${osvDbDate(opts.osvDbDir, [eco])?.slice(0, 10) ?? "an unknown date"}`
      );
    }
  }
  out.dbDate = osvDbDate(
    opts.osvDbDir,
    ecosystems.filter((e) => !out.unavailable.includes(e))
  );
  return out;
}


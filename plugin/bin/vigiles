var OsvGroupSchema = external_exports.looseObject({
  ids: external_exports.array(external_exports.string()),
  aliases: external_exports.array(external_exports.string()).nullish(),
  max_severity: external_exports.string().nullish()
});
var OsvPackageSchema = external_exports.looseObject({

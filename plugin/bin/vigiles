var UNSAFE_REF = /[\x00-\x20\x7f:\\]|\.\.|@\{/;
function assertSafeRef(ref) {
  const bad = ref === "" || UNSAFE_REF.test(ref) || ref.split("/").some((s) => s === "" || s.startsWith("-") || s.startsWith("+") || s.startsWith("."));

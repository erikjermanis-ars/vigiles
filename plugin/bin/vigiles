var ID_PREFERENCE = ["GHSA-", "MAL-"];
function representativeId(ids) {
  if (ids.length === 0) throw new Error("empty OSV group");
  const rank2 = (id) => {
    const i = ID_PREFERENCE.findIndex((p) => id.startsWith(p));
    return i === -1 ? ID_PREFERENCE.length : i;
  };
  return [...ids].sort((a, b) => rank2(a) - rank2(b) || (a < b ? -1 : a > b ? 1 : 0))[0];
}
function parseSeverityScore(value) {
  if (value === null || value === void 0 || value.trim() === "") return null;
  const n = Number(value);
  return Number.isFinite(n) && n >= 0 && n <= 10 ? n : null;
}
function toPackage(p) {
  const records = new Map((p.vulnerabilities ?? []).map((r) => [r.id, r]));
  const groups = [];
  for (const g of p.groups ?? []) {
    if (g.ids.length === 0) continue;
    const withRecords = g.ids.filter((id) => records.has(id));
    const osvId = representativeId(withRecords.length ? withRecords : g.ids);
    const ordered = [osvId, ...g.ids.filter((id) => id !== osvId).sort()];
    groups.push({
      osvId,
      ids: [...g.ids].sort(),
      aliases: [.../* @__PURE__ */ new Set([...g.ids, ...g.aliases ?? []])].sort(),
      maxSeverity: parseSeverityScore(g.max_severity),
      records: ordered.map((id) => records.get(id)).filter((r) => r !== void 0)
    });
  }
  return {
    name: p.package.name,
    version: p.package.version,
    ecosystem: p.package.ecosystem,
    dev: (p.dependency_groups ?? []).includes("dev"),
    groups
  };
}
function parseOsvOutput(json2) {
  const parsed = OsvOutputSchema.safeParse(json2);
  if (!parsed.success) {
    const issue2 = parsed.error.issues[0];
    throw new Error(`unexpected osv-scanner output at ${issue2?.path.map(String).join(".") ?? "?"}: ${issue2?.message ?? ""}`);
  }
  return (parsed.data.results ?? []).map((r) => ({ path: r.source.path, packages: (r.packages ?? []).map(toPackage) }));
}
function fixedVersionsFor(records, name, ecosystem) {
  const out = /* @__PURE__ */ new Set();
  for (const record2 of records) {
    for (const affected of record2.affected ?? []) {
      if (affected.package?.name !== name || affected.package?.ecosystem !== ecosystem) continue;
      for (const range of affected.ranges ?? []) {
        for (const event of range.events) {
          if (typeof event.fixed === "string" && event.fixed) out.add(event.fixed);
        }
      }
    }
  }
  return [...out].sort((a, b) => a.localeCompare(b, "en", { numeric: true }));
}
function stringArray(value) {
  return Array.isArray(value) ? value.filter((v) => typeof v === "string") : [];
}
function cvssVectorOf(record2) {
  const severity = record2.severity ?? [];
  return severity.find((s) => s.type === "CVSS_V4")?.score ?? severity.find((s) => s.type === "CVSS_V3")?.score ?? null;
}
var MALWARE_SUMMARY = /^(malicious package\b|malware in\b)|\b(is|contains) malware\b/i;
function isMalicious2(record2) {
  if (record2.id.startsWith("MAL-") || (record2.aliases ?? []).some((a) => a.startsWith("MAL-"))) return true;
  const cwes = record2.database_specific?.cwe_ids;
  if (Array.isArray(cwes) && cwes.includes("CWE-506")) return true;
  return MALWARE_SUMMARY.test(record2.summary ?? "");
}
function advisoryFromRecord(record2, maxSeverity, groupAliases = []) {
  const aliases = record2.aliases ?? [];

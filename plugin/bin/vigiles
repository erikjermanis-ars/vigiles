function num(v) {
  return typeof v === "number" && Number.isFinite(v) ? v : null;
}
function asRecord(v) {
  return v && typeof v === "object" && !Array.isArray(v) ? v : null;
}
function tryParseJson(text) {
  try {
    return JSON.parse(text);
  } catch {
    return void 0;
  }
}
function parseCliStdout(stdout) {
  const whole = asRecord(tryParseJson(stdout.trim()));
  if (whole) return whole;
  const lines = stdout.split("\n").filter((l) => l.trim());
  for (let i = lines.length - 1; i >= 0; i--) {
    const obj = asRecord(tryParseJson(lines[i].trim()));
    if (obj && obj.type === "result") return obj;
  }
  return null;
}
function resolveModel(raw, requested) {
  const keys = Object.keys(asRecord(raw.modelUsage) ?? {});
  return keys.find((k) => k.includes(requested)) ?? keys[0] ?? null;
}
function metricsFrom(raw, wallMs) {
  const usage2 = asRecord(raw?.usage) ?? {};
  const fresh = num(usage2.input_tokens);
  const created = num(usage2.cache_creation_input_tokens);
  return {
    costUsd: num(raw?.total_cost_usd),
    // Everything billed as non-cached input; input_tokens alone is usually a handful of tokens.
    inputTokens: fresh === null && created === null ? null : (fresh ?? 0) + (created ?? 0),
    outputTokens: num(usage2.output_tokens),
    cacheReadTokens: num(usage2.cache_read_input_tokens),
    numTurns: num(raw?.num_turns),
    durationMs: num(raw?.duration_ms) ?? wallMs
  };
}
function firstLine(s, max = 500) {
  const line = s.trim().split("\n").find((l) => l.trim()) ?? "";
  return line.slice(0, max);
}
function parseAttempt(run, requestedModel) {
  const base = { output: null, raw: null, modelResolved: null, permissionDenials: 0 };
  const empty = metricsFrom(null, run.durationMs);
  if (run.aborted) return { ...base, status: "cancelled", metrics: empty, error: "cancelled", retryable: false };
  if (run.timedOut) return { ...base, status: "timeout", metrics: empty, error: `timed out after ${run.durationMs} ms`, retryable: false };
  const raw = parseCliStdout(run.stdout);
  if (!raw) {
    const why = run.code === 0 ? "stdout is not a JSON object" : `exited ${run.code ?? run.signal}`;
    const detail = firstLine(run.stderr) || firstLine(run.stdout);
    return { ...base, status: "failed", metrics: empty, error: `claude ${why}${detail ? `: ${detail}` : ""}`, retryable: true };
  }
  const common = {
    raw,
    modelResolved: resolveModel(raw, requestedModel),
    metrics: metricsFrom(raw, run.durationMs),
    permissionDenials: Array.isArray(raw.permission_denials) ? raw.permission_denials.length : 0
  };
  if (raw.is_error === true || run.code !== 0) {
    const subtype = typeof raw.subtype === "string" ? raw.subtype : "error";
    const detail = typeof raw.result === "string" ? firstLine(raw.result) : firstLine(run.stderr);
    return {
      ...common,
      output: null,
      status: "failed",
      error: `claude ${subtype}${run.code !== 0 ? ` (exit ${run.code ?? run.signal})` : ""}${detail ? `: ${detail}` : ""}`,
      // Retrying a budget overrun would just spend the budget a second time.
      retryable: subtype !== "error_max_budget_usd"
    };
  }
  const candidate = raw.structured_output ?? (typeof raw.result === "string" ? tryParseJson(raw.result) : void 0);
  const parsed = TriageOutputSchema.safeParse(candidate);
  if (!parsed.success) {
    const issues = parsed.error.issues.slice(0, 3).map((i) => `${i.path.map(String).join(".") || "(root)"}: ${i.message}`).join("; ");
    return { ...common, output: null, status: "invalid", error: `invalid structured output: ${issues}`, retryable: true };
  }
  return { ...common, output: parsed.data, status: "ok", error: null, retryable: false };
}
function addNullable(a, b) {
  if (a === null) return b;
  if (b === null) return a;
  return a + b;
}
function sumMetrics(a, b) {
  return {
    costUsd: addNullable(a.costUsd, b.costUsd),
    inputTokens: addNullable(a.inputTokens, b.inputTokens),
    outputTokens: addNullable(a.outputTokens, b.outputTokens),
    cacheReadTokens: addNullable(a.cacheReadTokens, b.cacheReadTokens),
    numTurns: addNullable(a.numTurns, b.numTurns),
    durationMs: addNullable(a.durationMs, b.durationMs)
  };
}
async function runOnce(req, cwd) {
  let run;
  try {
    run = await runProcess(req.bin, buildClaudeArgs(req), {
      cwd,
      env: minimalEnv(),
      input: req.userPrompt,
      timeoutMs: req.timeoutMs,
      signal: req.signal
    });
  } catch (err) {
    const message2 = err instanceof Error ? err.message : String(err);
    return {
      status: "failed",
      output: null,
      raw: null,
      modelResolved: null,
      metrics: metricsFrom(null, 0),
      error: `could not start ${req.bin}: ${message2}`,
      permissionDenials: 0,
      retryable: false
    };
  }
  return parseAttempt(run, req.model);
}
var NO_METRICS = {
  costUsd: null,
  inputTokens: null,
  outputTokens: null,
  cacheReadTokens: null,
  numTurns: null,
  durationMs: null
};
async function runClaudeTriage(req) {
  const maxAttempts = req.maxAttempts ?? 2;
  let cwd;
  let tempDir = null;
  if (req.codeAccess) {
    if (!req.snapshotDir) throw new Error("runClaudeTriage: snapshotDir is required with code access");
    cwd = req.snapshotDir;
  } else {
    if (!req.scratchDir) throw new Error("runClaudeTriage: scratchDir is required without code access");
    (0, import_node_fs3.mkdirSync)(req.scratchDir, { recursive: true, mode: 448 });
    tempDir = (0, import_node_fs3.mkdtempSync)(import_node_path3.default.join(req.scratchDir, "triage-nocode-"));
    cwd = tempDir;
  }
  try {
    let metrics = NO_METRICS;
    let permissionDenials = 0;
    let lastRaw = null;
    let last = null;
    let attempts = 0;
    const retriedErrors = [];
    while (attempts < maxAttempts && !req.signal?.aborted) {
      if (last) retriedErrors.push(`attempt ${attempts}: ${last.status}: ${last.error ?? ""}`);
      attempts++;
      last = await runOnce(req, cwd);
      metrics = sumMetrics(metrics, last.metrics);
      permissionDenials += last.permissionDenials;
      lastRaw = last.raw ?? lastRaw;
      if (last.status === "ok" || !last.retryable) break;
    }
    return {
      status: last?.status ?? "cancelled",
      output: last?.output ?? null,
      raw: lastRaw,
      modelResolved: lastRaw ? resolveModel(lastRaw, req.model) : null,
      ...metrics,
      attempts,
      error: last ? last.error : "cancelled before start",
      retriedErrors,
      permissionDenials
    };
  } finally {
    if (tempDir) (0, import_node_fs3.rmSync)(tempDir, { recursive: true, force: true });
  }
}

// src/lib/triage/concurrency.ts
var MAX_CONSECUTIVE_CLI_FAILURES = 3;
async function forEachConcurrent(items, concurrency, signal, fn) {
  let next = 0;
  const errors = [];
  const worker = async () => {
    while (!signal.aborted && errors.length === 0 && next < items.length) {
      const index = next++;
      try {
        await fn(items[index], index);
      } catch (error62) {
        errors.push(error62);
      }
    }
  };
  await Promise.all(Array.from({ length: Math.max(1, Math.min(concurrency, items.length)) }, worker));
  if (errors.length) throw errors[0];
  return next;
}

// src/lib/triage/input-hash.ts
var import_node_fs4 = require("node:fs");
var import_node_path4 = __toESM(require("node:path"), 1);
var PROMPT_FILES = ["system.md", "user.md", "schema.json"];
var fingerprintCache = /* @__PURE__ */ new Map();
function promptFingerprint(version2, root = repoRoot()) {
  const files = PROMPT_FILES.map((f) => import_node_path4.default.join(root, "prompts/triage", `${version2}.${f}`));
  const statKey = files.map((f) => {
    const st = (0, import_node_fs4.statSync)(f, { throwIfNoEntry: false });
    return st ? `${st.mtimeMs}:${st.size}` : "missing";
  }).join("|");
  const cacheKey = `${root}\0${version2}`;
  const cached2 = fingerprintCache.get(cacheKey);
  if (cached2 && cached2.key === statKey) return cached2.value;
  const content = files.map((f) => {
    try {
      return (0, import_node_fs4.readFileSync)(f, "utf8");
    } catch {
      return "";
    }
  }).join("\0");
  const value = `${version2}@${sha256(content).slice(0, 8)}`;
  fingerprintCache.set(cacheKey, { key: statKey, value });
  return value;
}
function canonicalInstances(instances) {
  return instances.map((i) => [i.version, i.direct, i.devOnly, i.paths.map((p) => p.join(">")).sort()]).sort((a, b) => a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0);
}
function computeInputHash(i) {
  const canonical = JSON.stringify([
    i.advisoryModified ?? "",
    [...i.installedVersions].sort(),
    [...i.fixedVersions].sort(),
    i.direct,
    i.devOnly,
    i.paths.map((p) => p.join(">")).sort(),
    canonicalInstances(i.instances),
    i.importSites.map((s) => `${s.file}:${s.line}`).sort(),
    i.importSiteCount,
    i.projectProfileHash,
    i.promptVersion,
    i.model,
    i.effort,
    i.codeAccess
  ]);
  return sha256(canonical).slice(0, 16);
}


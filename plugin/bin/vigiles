var PLACEHOLDER = /⚠|\bTODO\b|Fill in/;
function formatZodError2(file2, err) {
  const lines = err.issues.map((i) => `  ${i.path.map(String).join(".") || "(root)"}: ${i.message}`);
  return `Invalid ${file2}:
${lines.join("\n")}`;
}
function placeholderPaths(value, at = "") {
  if (typeof value === "string") return PLACEHOLDER.test(value) ? [at || "(root)"] : [];
  if (Array.isArray(value)) return value.flatMap((v, i) => placeholderPaths(v, `${at}[${i}]`));
  if (value && typeof value === "object") {
    return Object.entries(value).flatMap(([k, v]) => placeholderPaths(v, at ? `${at}.${k}` : k));
  }
  return [];
}
function lineColumn(text, offset) {
  const before = text.slice(0, Math.max(0, Math.min(offset, text.length)));
  const lines = before.split("\n");
  return { line: lines.length, column: lines[lines.length - 1].length + 1 };
}
function yamlErrorText(text, err) {
  const e = err;
  const code2 = typeof e.code === "string" ? e.code : "SYNTAX_ERROR";
  const offset = Array.isArray(e.pos) && typeof e.pos[0] === "number" ? e.pos[0] : null;
  if (offset === null) return `not valid YAML (${code2})`;
  const { line, column } = lineColumn(text, offset);
  return `not valid YAML (${code2} at line ${line}, column ${column})`;
}
function loadProfile(file2) {
  let text;
  try {
    text = readRegularFile(file2);
  } catch (err) {
    if (err.code === "ENOENT") throw new ProfileMissingError(file2);
    if (err instanceof UnsafeRepoFileError) throw new ProfileInvalidError(err.message);
    throw err;
  }
  let raw;
  try {
    raw = (0, import_yaml3.parse)(text, { prettyErrors: false, logLevel: "error" });
  } catch (err) {
    throw new ProfileInvalidError(`Invalid ${file2}: ${yamlErrorText(text, err)}`);
  }
  if (raw === null || raw === void 0) throw new ProfileInvalidError(`Invalid ${file2}: the file is empty`);
  const parsed = PluginProfileSchema.safeParse(raw);
  if (!parsed.success) throw new ProfileInvalidError(formatZodError2(file2, parsed.error));
  const placeholders = placeholderPaths(parsed.data);
  const warnings = placeholders.length ? [`profile: ${placeholders.join(", ")} still hold a placeholder (⚠, TODO or "Fill in"); triage reads them as written, so fill them in`] : [];
  return { profile: parsed.data, warnings };
}

};
function lockfileEcosystem(file2) {
  const base = import_node_path9.default.posix.basename(file2);
  return LOCKFILE_RULES.find((r) => r.test(base))?.ecosystem ?? null;
}
function isLockfile(file2) {
  return lockfileEcosystem(file2) !== null;
}
function hasNodeModulesSegment(file2) {
  return file2.split("/").includes("node_modules");
}
function excludeMatcher(globs) {
  if (globs.length === 0) return () => false;
  const isMatch = (0, import_picomatch.default)(globs, { dot: true });
  return (file2) => isMatch(file2);
}
function lockfileCoverageDir(lockfile) {
  const dir = import_node_path9.default.posix.dirname(lockfile);
  const segments = dir === "." ? [] : dir.split("/");
  const bundle = segments.findIndex((s) => s.endsWith(".xcodeproj") || s.endsWith(".xcworkspace"));
  const kept = bundle === -1 ? segments : segments.slice(0, bundle);
  return kept.join("/");
}
function isSameOrAncestorDir(ancestor, dir) {
  return ancestor === "" || dir === ancestor || dir.startsWith(`${ancestor}/`);
}
function findCoverageGaps(files, lockfiles, exclude = []) {
  const isExcluded = excludeMatcher(exclude);
  const covering = lockfiles.map((l) => ({ base: import_node_path9.default.posix.basename(l), dir: lockfileCoverageDir(l) }));
  const gaps = [];
  for (const file2 of files) {
    const covers = MANIFEST_COVERAGE[import_node_path9.default.posix.basename(file2)];
    if (!covers || hasNodeModulesSegment(file2) || isExcluded(file2)) continue;
    const dir = import_node_path9.default.posix.dirname(file2) === "." ? "" : import_node_path9.default.posix.dirname(file2);
    const covered = covering.some((l) => covers(l.base) && isSameOrAncestorDir(l.dir, dir));
    if (!covered) gaps.push(file2);
  }
  return gaps.sort();
}
var LockfileDiscoveryError = class extends Error {
};
function discoverLockfiles(files, profile) {
  let lockfiles;
  if (profile.lockfiles && profile.lockfiles.length > 0) {
    const present = new Set(files);
    const missing = profile.lockfiles.filter((l) => !present.has(l));
    if (missing.length) {
      throw new LockfileDiscoveryError(`lockfiles listed in the profile are missing at this commit: ${missing.join(", ")}`);
    }
    const unknown2 = profile.lockfiles.filter((l) => !isLockfile(l));
    if (unknown2.length) {
      throw new LockfileDiscoveryError(`not a supported lockfile name: ${unknown2.join(", ")}`);
    }
    lockfiles = [...new Set(profile.lockfiles)];
  } else {
    const isExcluded = excludeMatcher(profile.exclude);
    lockfiles = files.filter((f) => isLockfile(f) && !hasNodeModulesSegment(f) && !isExcluded(f));
  }
  lockfiles.sort();
  return { lockfiles, coverageGaps: findCoverageGaps(files, lockfiles, profile.exclude) };
}


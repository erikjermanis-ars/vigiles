// src/plugin/verdicts.ts
var import_node_fs8 = require("node:fs");
function keyOf(k) {
  return [k.osvId, k.ecosystem, k.packageName, k.lockfile].join("\0");
}
function compareStrings(a, b) {
  return a < b ? -1 : a > b ? 1 : 0;
}
function compareVerdicts(a, b) {
  return compareStrings(a.osvId, b.osvId) || compareStrings(a.ecosystem, b.ecosystem) || compareStrings(a.packageName, b.packageName) || compareStrings(a.lockfile, b.lockfile);
}
function errorCode(err) {
  return err?.code;
}
var VerdictStore = class {
  byKey = /* @__PURE__ */ new Map();
  constructor(verdicts = []) {
    for (const v of verdicts) this.upsert(v);
  }
  get size() {
    return this.byKey.size;
  }
  /** The stored verdict for this finding, whatever inputs it was made for. */
  get(f) {
    return this.byKey.get(keyOf(f)) ?? null;
  }
  /** The stored verdict only when it was made for the finding's current inputs. */
  current(f) {
    const v = this.get(f);
    return v && v.inputHash === f.inputHash ? v : null;
  }
  /** Adds or replaces the verdict for its finding. Validated and normalised (schema key order) on the way in. */
  upsert(v) {
    const parsed = StoredVerdictSchema.parse(v);
    this.byKey.set(keyOf(parsed), parsed);
  }
  /** Every verdict, sorted (osvId, ecosystem, packageName, lockfile). */
  all() {
    return [...this.byKey.values()].sort(compareVerdicts);
  }
  toFile() {
    return { format: STATE_FORMAT, verdicts: this.all() };
  }
  /** Atomic write, 2-space JSON with a trailing newline (small, reviewable diffs). Refuses a symlinked directory. */
  save(file2) {
    writeRepoFile(file2, `${JSON.stringify(this.toFile(), null, 2)}
`);
  }
};
function describeEntry(entry, index) {
  const e = entry && typeof entry === "object" ? entry : {};
  const what = [e.osvId, e.packageName].filter((x) => typeof x === "string").join(" ");
  return `entry ${index + 1}${what ? ` (${what})` : ""}`;
}
function jsonErrorPosition(text, err) {
  const message2 = err instanceof Error ? err.message : "";
  const lc = /line (\d+) column (\d+)/.exec(message2);
  if (lc) return ` (line ${lc[1]}, column ${lc[2]})`;
  const pos = /position (\d+)/.exec(message2);
  if (!pos) return "";
  const lines = text.slice(0, Number(pos[1])).split("\n");
  return ` (line ${lines.length}, column ${lines[lines.length - 1].length + 1})`;
}
function loadVerdicts(file2) {
  let text;
  try {
    text = readRegularFile(file2);
  } catch (err) {
    if (errorCode(err) === "ENOENT") return { store: new VerdictStore(), warnings: [] };
    throw err;
  }
  if (/^(<{7}|={7}|>{7})( |$)/m.test(text)) {
    throw new Error(`${file2} has unresolved merge conflict markers; resolve them (keeping either side is fine) and run again`);
  }
  let json2;
  try {
    json2 = JSON.parse(text);
  } catch (err) {
    throw new Error(`${file2} is not valid JSON${jsonErrorPosition(text, err)}`);
  }
  if (!json2 || typeof json2 !== "object" || Array.isArray(json2))
    throw new Error(`${file2} is not a Vigiles verdict file (expected an object)`);
  const obj = json2;
  if (obj.format !== STATE_FORMAT) {
    const newer = typeof obj.format === "number" && obj.format > STATE_FORMAT;
    throw new Error(
      newer ? `${file2} was written by a newer Vigiles (format ${obj.format}); update the plugin` : `${file2} has an unknown format ${JSON.stringify(obj.format)} (expected ${STATE_FORMAT})`
    );
  }
  if (!Array.isArray(obj.verdicts)) throw new Error(`${file2}: "verdicts" must be an array`);
  const warnings = [];
  const store = new VerdictStore();
  obj.verdicts.forEach((entry, i) => {
    const parsed = StoredVerdictSchema.safeParse(entry);
    if (!parsed.success) {
      const issue2 = parsed.error.issues[0];
      const where = issue2 ? `${issue2.path.map(String).join(".") || "(root)"}: ${issue2.message}` : "invalid";
      warnings.push(`verdicts.json ${describeEntry(entry, i)} is invalid and was ignored (${where}); it will be triaged again`);
      return;
    }
    const existing = store.get(parsed.data);
    if (existing) {
      warnings.push(`verdicts.json ${describeEntry(entry, i)} duplicates another entry; kept the newer one`);
      if (existing.triagedAt >= parsed.data.triagedAt) return;
    }
    store.upsert(parsed.data);
  });
  return { store, warnings };
}
function isFailure(v) {
  if (!v || typeof v !== "object") return false;
  const f = v;
  return typeof f.inputHash === "string" && typeof f.error === "string" && typeof f.at === "string";
}
function loadFailures(file2) {
  let json2;
  try {
    json2 = JSON.parse((0, import_node_fs8.readFileSync)(file2, "utf8"));
  } catch {
    return {};
  }
  if (!json2 || typeof json2 !== "object" || Array.isArray(json2)) return {};
  const out = {};
  for (const [id, v] of Object.entries(json2)) {
    if (isFailure(v)) out[id] = { inputHash: v.inputHash, error: v.error, at: v.at };
  }
  return out;
}
function saveFailures(file2, failures) {
  const sorted = {};
  for (const id of Object.keys(failures).sort(compareStrings)) sorted[id] = failures[id];
  writeFileAtomic(file2, `${JSON.stringify(sorted, null, 2)}
`);
}


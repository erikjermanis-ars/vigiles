async function findRepoRoot(cwd, git) {
  try {
    const r = await runChecked(git, ["-C", cwd, "rev-parse", "--show-toplevel"], { timeoutMs: 15e3 });
    return r.stdout.trim();
  } catch (err) {
    throw new Error(`${cwd} is not inside a git repository (Vigiles reads lockfiles and code from git)`, { cause: err });
  }
}
function ensureDir(dir) {
  (0, import_node_fs7.mkdirSync)(dir, { recursive: true, mode: 448 });
  return dir;
}
function writeFileAtomic(file2, text) {
  ensureDir(import_node_path7.default.dirname(file2));
  const tmp = `${file2}.tmp-${process.pid}-${Date.now()}`;
  try {
    (0, import_node_fs7.writeFileSync)(tmp, text, { mode: 420 });
    (0, import_node_fs7.renameSync)(tmp, file2);
  } finally {
    (0, import_node_fs7.rmSync)(tmp, { force: true });
  }
}
var VIGILES_GITIGNORE = "# Written by Vigiles. Commit this directory (profile.yaml, verdicts.json and this file); report.md is regenerated on every run.\nreport.md\n";
var UnsafeRepoFileError = class extends Error {
  constructor(message2) {
    super(message2);
    this.name = "UnsafeRepoFileError";
  }
};
function errnoCode(err) {
  return err?.code;
}
function assertRealDirectory(dir) {
  const st = (0, import_node_fs7.lstatSync)(dir, { throwIfNoEntry: false });
  if (!st) return;
  if (st.isSymbolicLink()) {
    throw new UnsafeRepoFileError(`${dir} is a symlink; Vigiles only uses a real directory there. Replace it with a directory`);
  }
  if (!st.isDirectory()) throw new UnsafeRepoFileError(`${dir} is not a directory`);
}
function readRegularFile(file2) {
  assertRealDirectory(import_node_path7.default.dirname(file2));
  let fd;
  try {
    fd = (0, import_node_fs7.openSync)(file2, import_node_fs7.constants.O_RDONLY | import_node_fs7.constants.O_NOFOLLOW | import_node_fs7.constants.O_NONBLOCK);
  } catch (err) {
    if (errnoCode(err) === "ELOOP" || errnoCode(err) === "EMLINK") {
      throw new UnsafeRepoFileError(`${file2} is a symlink; Vigiles only reads a regular file there. Replace it with a real file`);
    }
    throw err;
  }
  try {
    if (!(0, import_node_fs7.fstatSync)(fd).isFile()) throw new UnsafeRepoFileError(`${file2} is not a regular file`);
    return (0, import_node_fs7.readFileSync)(fd, "utf8");
  } finally {
    (0, import_node_fs7.closeSync)(fd);
  }
}
function writeRepoFile(file2, text) {
  assertRealDirectory(import_node_path7.default.dirname(file2));
  writeFileAtomic(file2, text);
}


var PolicySchema = external_exports.object({
  /**
   * Findings of the same advisory in the same project and lockfile (one problem on several packages, e.g. one
   * Sentry advisory on @sentry/node, @sentry/node-core and @sentry/nestjs) get the most urgent action any of them
   * received ('max'), so separate LLM runs on one problem never disagree. 'off' decides each finding alone.
   */
  same_advisory: external_exports.enum(["max", "off"]).default("max"),
  thresholds: external_exports.object({
    epss_high: external_exports.number().min(0).max(1),
    epss_medium: external_exports.number().min(0).max(1),
    cvss_critical: external_exports.number().min(0).max(10),
    cvss_high: external_exports.number().min(0).max(10)
  }),
  rules: external_exports.array(PolicyRuleSchema).min(1)
});


var import_node_fs5 = require("node:fs");
var import_node_path5 = __toESM(require("node:path"), 1);
var SOURCE_EXTENSIONS = /* @__PURE__ */ new Set([".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]);
var SKIPPED_DIRS = /* @__PURE__ */ new Set(["node_modules", "__tests__", "__mocks__", "stories", ".storybook"]);
var MAX_FILE_BYTES = 2 * 1024 * 1024;
var MAX_IMPORT_SITES = 20;
function isScannableSource(file2) {
  const segments = file2.split("/");
  const base = segments[segments.length - 1];
  if (segments.slice(0, -1).some((s) => SKIPPED_DIRS.has(s))) return false;
  if (!SOURCE_EXTENSIONS.has(import_node_path5.default.posix.extname(base))) return false;
  if (/\.d\.[cm]?ts$/.test(base)) return false;
  return !/\.(test|spec|stories)\.[^/]+$/.test(base);
}
function importSiteKind(file2, packageDir2 = "") {
  const prefix = packageDir2 ? `${packageDir2}/` : "";
  if (!file2.startsWith(prefix)) return "source";
  const segments = file2.slice(prefix.length).split("/");
  const base = segments[0];
  if (segments.length === 1 && (/.\.(config|setup)\.[cm]?[jt]sx?$/.test(base) || /^\.[^/]*rc\.[cm]?[jt]s$/.test(base))) return "config";
  if (segments.length > 1 && segments[0] === "scripts") return "script";
  return "source";
}
var IMPORT_PATTERNS = [
  // import x from 'p' / import { a } from 'p' / export * from 'p' / import type { T } from 'p' (may span lines;
  // the span may not cross another import/export keyword, so the reported line is the statement's own)
  /\b(?:import|export)\s(?:(?!\b(?:import|export)\b)[^'"`;])*?\bfrom\s*(['"])([^'"\n]+)\1/g,
  // import 'p' (side effects only)
  /\bimport\s*(['"])([^'"\n]+)\1/g,
  // require('p'), import('p')
  /\b(?:require|import)\s*\(\s*(['"])([^'"\n]+)\1\s*\)/g
];
function lineStarts(text) {
  const starts = [0];
  for (let i = 0; i < text.length; i++) if (text.charCodeAt(i) === 10) starts.push(i + 1);
  return starts;
}
function lineIndexAt(starts, offset) {
  let lo = 0;
  let hi = starts.length - 1;
  while (lo < hi) {
    const mid = lo + hi + 1 >> 1;
    if (starts[mid] <= offset) lo = mid;
    else hi = mid - 1;
  }
  return lo;
}
function extractImportSpecifiers(source) {
  const starts = lineStarts(source);
  const hits = [];
  const seen = /* @__PURE__ */ new Set();
  for (const pattern of IMPORT_PATTERNS) {
    pattern.lastIndex = 0;
    for (let m = pattern.exec(source); m; m = pattern.exec(source)) {
      const idx = lineIndexAt(starts, m.index);
      const before = source.slice(starts[idx], m.index).trimStart();
      if (before.startsWith("//") || before.startsWith("*") || before.startsWith("/*")) continue;
      const specifier = m[2];
      const key = `${idx}\0${specifier}`;
      if (seen.has(key)) continue;
      seen.add(key);
      hits.push({ specifier, line: idx + 1 });
    }
  }
  return hits.sort((a, b) => a.line - b.line || a.specifier.localeCompare(b.specifier));
}
function packageNameFromSpecifier(specifier) {
  if (/^[./#~]/.test(specifier) || /^[a-z][a-z0-9+.-]*:/i.test(specifier)) return null;
  const parts = specifier.split("/");
  if (specifier.startsWith("@")) return parts[0].length > 1 && parts[1] ? `${parts[0]}/${parts[1]}` : null;
  return parts[0] || null;
}
function buildImportIndex(rootDir, files) {
  const byPackage = /* @__PURE__ */ new Map();
  let filesScanned = 0;
  for (const file2 of [...files].sort()) {
    if (!isScannableSource(file2)) continue;
    const full = import_node_path5.default.join(rootDir, file2);
    const st = (0, import_node_fs5.lstatSync)(full, { throwIfNoEntry: false });
    if (!st?.isFile() || st.size > MAX_FILE_BYTES) continue;
    filesScanned++;
    for (const hit of extractImportSpecifiers((0, import_node_fs5.readFileSync)(full, "utf8"))) {
      const pkg = packageNameFromSpecifier(hit.specifier);
      if (!pkg) continue;
      const site = { file: file2, line: hit.line, specifier: hit.specifier };
      const list = byPackage.get(pkg);
      if (list) list.push(site);
      else byPackage.set(pkg, [site]);
    }
  }
  return { byPackage, filesScanned };
}
function owningDir(file2, lockfileDirs) {
  let best = null;
  for (const dir of lockfileDirs) {
    const inside = dir === "" || file2.startsWith(`${dir}/`);
    if (inside && (best === null || dir.length > best.length)) best = dir;
  }
  return best;
}
function searchImportSites(index, q) {
  const max = q.max ?? MAX_IMPORT_SITES;
  const perPackage = [...new Set(q.packages)].map(
    (pkg) => (index.byPackage.get(pkg) ?? []).filter((s) => owningDir(s.file, q.allLockfileDirs) === q.lockfileDir).map((s) => ({ ...s, via: pkg }))
  );
  const total = perPackage.reduce((n, list) => n + list.length, 0);
  const picked = [];
  for (let round = 0; picked.length < max; round++) {
    let any2 = false;
    for (const list of perPackage) {
      const site = list[round];
      if (!site) continue;
      any2 = true;
      if (picked.length < max) picked.push(site);
    }
    if (!any2) break;
  }
  const sites = picked.sort((a, b) => a.file.localeCompare(b.file) || a.line - b.line || a.via.localeCompare(b.via));
  return { sites, total };
}


function suggestId(repoRoot2) {
  const id = import_node_path12.default.basename(repoRoot2).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  return id || "project";
}
function titleCase(id) {
  return id.split("-").filter(Boolean).map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
}
async function headCommit(git, repoRoot2) {
  const r = await runChecked(git, ["-C", repoRoot2, "rev-parse", "--verify", "--quiet", "HEAD^{commit}"], {
    timeoutMs: 15e3,
    okCodes: [0, 1, 128]
  });
  if (r.code !== 0) return null;
  const { sha, date: date5 } = await gitResolveRef(git, repoRoot2, "HEAD");
  return { commit: sha, date: date5 };
}
async function showOrNull(git, repoRoot2, sha, file2) {
  try {
    return await gitShowFile(git, repoRoot2, sha, file2);
  } catch {
    return null;
  }
}
async function detectFacts(repoRoot2, git) {
  const id = suggestId(repoRoot2);
  const [head, branch, defaultBranch, remotes] = await Promise.all([
    headCommit(git, repoRoot2),
    currentBranch(git, repoRoot2),
    defaultRemoteBranch(git, repoRoot2),
    listRemotes(git, repoRoot2)
  ]);
  const facts = {
    repoRoot: repoRoot2,
    suggestedId: id,
    suggestedName: titleCase(id) || id,
    head,
    currentBranch: branch,
    defaultBranch,
    remotes,
    lockfiles: [],
    ecosystems: [],
    coverageGaps: [],
    infraFiles: [],
    infraFilesTotal: 0,
    frameworks: [],
    nodeVersion: null,
    languages: []
  };
  if (!head) return facts;
  const files = await gitLsTree(git, repoRoot2, head.commit);
  const present = new Set(files);
  const { lockfiles, coverageGaps } = discoverLockfiles(files, { exclude: [] });
  facts.lockfiles = lockfiles.map((file2) => ({ file: file2, ecosystem: lockfileEcosystem(file2) }));
  facts.ecosystems = [...new Set(facts.lockfiles.map((l) => l.ecosystem))].sort();
  facts.coverageGaps = coverageGaps;
  const infra = [...new Set(files.map(infraEntry).filter((e) => e !== null))].sort();
  facts.infraFilesTotal = infra.length;
  facts.infraFiles = infra.slice(0, MAX_INFRA_FILES);
  const npmDirs = facts.lockfiles.filter((l) => l.ecosystem === "npm").map((l) => import_node_path12.default.posix.dirname(l.file));
  const manifests = [.../* @__PURE__ */ new Set([".", ...npmDirs])].map((dir) => dir === "." ? "package.json" : `${dir}/package.json`).filter((m) => present.has(m)).slice(0, MAX_MANIFESTS);
  let usesTypeScript = files.some((f) => import_node_path12.default.posix.basename(f) === "tsconfig.json" && !f.includes("node_modules/"));
  for (const manifest of manifests) {
    const text = await showOrNull(git, repoRoot2, head.commit, manifest);
    if (text === null) continue;
    const packages = notablePackages(text);
    if (packages.some((p) => p.startsWith("typescript@"))) usesTypeScript = true;
    if (packages.length) facts.frameworks.push({ manifest, packages });
    if (manifest === "package.json" && !facts.nodeVersion) {
      try {
        const engines = JSON.parse(text).engines;
        if (typeof engines?.node === "string") facts.nodeVersion = engines.node;
      } catch {
      }
    }
  }
  for (const file2 of [".nvmrc", ".node-version"]) {
    if (!present.has(file2)) continue;
    const text = (await showOrNull(git, repoRoot2, head.commit, file2))?.trim();
    if (text && /^[\w.*^~<>=|\s-]{1,40}$/.test(text)) {
      facts.nodeVersion = text;
      break;
    }
  }
  facts.languages = [
    ...new Set(facts.ecosystems.map((e) => e === "npm" && usesTypeScript ? "typescript" : LANGUAGE_BY_ECOSYSTEM[e] ?? e))
  ];
  return facts;
}
function oneLine3(text) {
  let out = "";
  for (const ch of text) {
    const code2 = ch.charCodeAt(0);
    out += code2 < 32 || code2 === 127 ? "?" : ch;
  }
  return out;
}
function detectedLines(facts) {
  if (!facts.head) return ["# No commit at HEAD yet: commit your lockfiles before the first audit."];
  const where = facts.currentBranch ? `on ${facts.currentBranch}` : "detached HEAD";
  const out = [`# Detected at HEAD (${facts.head.commit.slice(0, 10)} ${where}, ${facts.head.date.slice(0, 10)}):`];
  out.push(
    `#   lockfiles: ${facts.lockfiles.length ? facts.lockfiles.map((l) => `${oneLine3(l.file)} (${l.ecosystem})`).join(", ") : "none found"}`
  );
  if (facts.coverageGaps.length) out.push(`#   manifests without a lockfile (not audited): ${facts.coverageGaps.map(oneLine3).join(", ")}`);
  if (facts.infraFiles.length) {
    const more = facts.infraFilesTotal > facts.infraFiles.length ? ` (+${facts.infraFilesTotal - facts.infraFiles.length} more)` : "";
    out.push(`#   deployment/CI/infra files: ${facts.infraFiles.map(oneLine3).join(", ")}${more}`);
  }
  for (const r of facts.remotes) out.push(`#   remote ${oneLine3(r.name)}: ${oneLine3(r.url)}`);
  if (facts.defaultBranch) out.push(`#   default branch: ${oneLine3(facts.defaultBranch)}`);
  for (const f of facts.frameworks) out.push(`#   ${oneLine3(f.manifest)}: ${f.packages.map(oneLine3).join(", ")}`);
  return out;
}
function profileTemplate(facts) {
  const q = (s) => JSON.stringify(oneLine3(s));
  const list = (items) => `[${items.map(q).join(", ")}]`;
  const frameworks = [...new Set(facts.frameworks.flatMap((f) => f.packages).filter((p) => !p.startsWith("typescript@")))];
  const lines = [

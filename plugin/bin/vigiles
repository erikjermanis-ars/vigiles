}
function lockfileDir(lockfile) {
  const dir = import_node_path13.default.posix.dirname(lockfile);
  return dir === "." ? "" : dir;
}
var byVersion = (a, b) => a.localeCompare(b, "en", { numeric: true });
function buildInventory(scan2) {
  const items = /* @__PURE__ */ new Map();
  const graph = scan2.npmGraph ?? null;
  for (const p of scan2.packages) {
    const key = `${p.ecosystem}\0${p.name}\0${p.version}`;
    const existing = items.get(key);
    if (existing) {
      existing.devOnly = existing.devOnly && p.dev;
      continue;
    }
    items.set(key, {
      lockfile: scan2.lockfile,
      ecosystem: p.ecosystem,
      name: p.name,
      version: p.version,
      direct: graph ? isDirect(graph, p.name, [p.version]) : null,
      devOnly: graph ? isDevOnly(graph, p.name, [p.version]) ?? p.dev : p.dev
    });
  }
  return [...items.values()];
}
function instanceFacts(acc, versions) {
  const graph = acc.graph;
  return versions.map((version2) => {
    const osvDev = acc.devByVersion.get(version2) === true;
    if (!graph) return { version: version2, direct: null, devOnly: osvDev, paths: [] };
    return {
      version: version2,
      direct: isDirect(graph, acc.name, [version2]),
      devOnly: isDevOnly(graph, acc.name, [version2]) ?? osvDev,
      paths: shortestPaths(graph, acc.name, [version2])
    };
  });
}
function importSearchFor(name, instances) {
  const out = /* @__PURE__ */ new Set();
  if (instances.some((i) => i.direct)) out.add(name);
  for (const i of instances) {
    if (i.direct) continue;
    for (const p of i.paths) if (p[0]) out.add(p[0]);
  }
  return [...out];
}
function finalizeFinding(acc, opts, npmLockfileDirs) {
  const versions = [...acc.versions].sort(byVersion);
  const records = [...acc.records.values()];
  const graph = acc.graph;
  const instances = instanceFacts(acc, versions);
  let direct = null;
  const devOnly = instances.every((i) => i.devOnly);
  let paths = [];
  let importSites = [];
  let importSiteCount = 0;
  if (graph) {
    direct = instances.some((i) => i.direct === true);
    paths = shortestPaths(graph, acc.name, versions);
    const searchFor = importSearchFor(acc.name, instances);
    if (opts.importIndex && searchFor.length) {
      const found = searchImportSites(opts.importIndex(), {
        lockfileDir: lockfileDir(acc.lockfile),
        allLockfileDirs: npmLockfileDirs,
        packages: searchFor
      });
      importSites = found.sites;
      importSiteCount = found.total;
    }
  }
  return {
    lockfile: acc.lockfile,
    ecosystem: acc.ecosystem,
    packageName: acc.name,
    osvId: acc.osvId,
    installedVersions: versions,
    fixedVersions: fixedVersionsFor(records, acc.name, acc.ecosystem),
    direct,
    devOnly,
    paths,
    instances,
    importSites,
    importSiteCount,
    advisoryModified: acc.records.get(acc.osvId)?.modified ?? null
  };
}
function observeScan(scans, opts = {}) {
  let index;
  const build = opts.importIndex;
  const memoized = build ? { importIndex: () => index ??= build() } : {};
  const inventory = [];
  const advisories = /* @__PURE__ */ new Map();
  const accumulators = /* @__PURE__ */ new Map();
  const vulnerable = /* @__PURE__ */ new Set();
  const npmLockfileDirs = scans.filter((s) => s.npmGraph).map((s) => lockfileDir(s.lockfile));
  for (const scan2 of scans) {
    inventory.push(...buildInventory(scan2));
    for (const p of scan2.packages) {
      for (const group of p.groups) {
        for (const record2 of group.records) {
          const groupAliases = record2.id === group.osvId ? group.aliases : [];
          if (!advisories.has(record2.id)) advisories.set(record2.id, advisoryFromRecord(record2, group.maxSeverity, groupAliases));
        }
        const representative = group.records.find((r) => r.id === group.osvId);
        if (!representative || representative.withdrawn) continue;
        vulnerable.add(`${scan2.lockfile}\0${p.ecosystem}\0${p.name}\0${p.version}`);
        const key = findingKey({ lockfile: scan2.lockfile, ecosystem: p.ecosystem, packageName: p.name, osvId: group.osvId });
        let acc = accumulators.get(key);
        if (!acc) {
          acc = {
            lockfile: scan2.lockfile,
            ecosystem: p.ecosystem,
            name: p.name,
            osvId: group.osvId,
            graph: scan2.npmGraph ?? null,
            versions: /* @__PURE__ */ new Set(),
            devByVersion: /* @__PURE__ */ new Map(),
            records: /* @__PURE__ */ new Map()
          };
          accumulators.set(key, acc);
        }
        acc.versions.add(p.version);
        acc.devByVersion.set(p.version, (acc.devByVersion.get(p.version) ?? true) && p.dev);
        for (const r of group.records) if (!acc.records.has(r.id)) acc.records.set(r.id, r);
      }
    }
  }
  const findings = [...accumulators.values()].map((acc) => finalizeFinding(acc, memoized, npmLockfileDirs)).sort((a, b) => findingKey(a).localeCompare(findingKey(b)));
  return {
    inventory,
    findings,
    advisories: [...advisories.values()],
    packages: inventory.length,
    vulnerablePackages: vulnerable.size
  };
}


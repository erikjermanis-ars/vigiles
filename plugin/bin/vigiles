var import_node_child_process = require("node:child_process");
var ProcessError = class extends Error {
  constructor(message2, result2) {
    super(message2);
    this.result = result2;
  }
  result;
};
function runProcess(cmd, args, opts = {}) {
  const started = Date.now();
  const maxBuffer = opts.maxBuffer ?? 64 * 1024 * 1024;
  return new Promise((resolve, reject) => {
    const child = (0, import_node_child_process.spawn)(cmd, args, {
      cwd: opts.cwd,
      env: opts.env ?? process.env,
      stdio: ["pipe", "pipe", "pipe"]
    });
    let stdout = "";
    let stderr = "";
    let timedOut = false;
    let aborted2 = false;
    let settled = false;
    const kill = () => {
      if (child.exitCode === null && child.signalCode === null) {
        child.kill("SIGTERM");
        setTimeout(() => {
          if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
        }, 3e3).unref();
      }
    };
    const timer = opts.timeoutMs ? setTimeout(() => {
      timedOut = true;
      kill();
    }, opts.timeoutMs) : void 0;
    const onAbort = () => {
      aborted2 = true;
      kill();
    };
    if (opts.signal) {
      if (opts.signal.aborted) onAbort();
      else opts.signal.addEventListener("abort", onAbort, { once: true });
    }
    child.stdout.setEncoding("utf8");
    child.stderr.setEncoding("utf8");
    child.stdout.on("data", (d) => {
      if (stdout.length < maxBuffer) stdout += d;
    });
    child.stderr.on("data", (d) => {
      if (stderr.length < maxBuffer) stderr += d;
    });
    child.on("error", (err) => {
      if (settled) return;
      settled = true;
      if (timer) clearTimeout(timer);
      opts.signal?.removeEventListener("abort", onAbort);
      reject(err);
    });
    child.on("close", (code2, signal) => {
      if (settled) return;
      settled = true;
      if (timer) clearTimeout(timer);
      opts.signal?.removeEventListener("abort", onAbort);
      resolve({ code: code2, signal, stdout, stderr, timedOut, aborted: aborted2, durationMs: Date.now() - started });
    });
    child.stdin.on("error", () => {
    });
    if (opts.input !== void 0) child.stdin.end(opts.input);
    else child.stdin.end();
  });
}
async function runChecked(cmd, args, opts = {}) {
  const r = await runProcess(cmd, args, opts);
  const ok = opts.okCodes ?? [0];
  if (r.timedOut) throw new ProcessError(`${cmd} timed out after ${opts.timeoutMs}ms`, r);
  if (r.aborted) throw new ProcessError(`${cmd} was cancelled`, r);
  if (r.code === null || !ok.includes(r.code)) {
    throw new ProcessError(`${cmd} ${args.slice(0, 3).join(" ")} exited ${r.code ?? r.signal}: ${r.stderr.trim().slice(0, 2e3)}`, r);
  }
  return r;
}
function minimalEnv(extra = {}) {
  const env = {};
  for (const k of ["HOME", "PATH", "USER", "LOGNAME", "LANG", "TMPDIR", "SHELL"]) {
    const v = process.env[k];
    if (v) env[k] = v;
  }
  env.LANG ??= "en_US.UTF-8";
  return { ...env, ...extra };
}


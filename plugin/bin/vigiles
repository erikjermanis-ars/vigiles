var COMPLETE_MARKER = ".vigiles-snapshot-complete";
var SNAPSHOT_FORMAT = 3;
var DEFAULT_SNAPSHOT_TIMEOUT_MS = 5 * 6e4;
var MAX_SKIPPED_EXAMPLES = 20;
var UNWRITABLE_CODES = /* @__PURE__ */ new Set(["EEXIST", "ENOTDIR", "EISDIR", "ENAMETOOLONG", "EILSEQ"]);
function snapshotDir(snapshotsRoot, projectId, sha) {
  return import_node_path2.default.join(snapshotsRoot, projectId, sha);
}
function isScrubbedName(name) {

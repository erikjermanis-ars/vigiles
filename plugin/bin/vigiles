    real = (0, import_node_fs7.realpathSync)(repoRoot2);
  } catch {
  }
  return `${projectId}-${(0, import_node_crypto3.createHash)("sha256").update(real).digest("hex").slice(0, 8)}`;
}
function repoPaths(repoRoot2, projectId, plugin) {

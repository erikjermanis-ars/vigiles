var LOCKFILE_RULES = [
  { test: exact("package-lock.json"), ecosystem: "npm" },
  { test: exact("pnpm-lock.yaml"), ecosystem: "npm" },
  { test: exact("yarn.lock"), ecosystem: "npm" },

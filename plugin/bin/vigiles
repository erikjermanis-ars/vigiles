  };
}
function auditedRef(scan2) {
  return scan2.branch ?? scan2.ref;
}
function priorityRank2(p) {
  return p ? PRIORITIES.indexOf(p) : PRIORITIES.length;
}
function descNullsLast(a, b) {
  if (a === b) return 0;
  if (a === null) return 1;
  if (b === null) return -1;
  return b - a;
}
function compareCandidates(a, b) {
  return priorityRank2(a.priority) - priorityRank2(b.priority) || descNullsLast(a.epss, b.epss) || descNullsLast(a.cvssScore, b.cvssScore) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0);
}
function isMaliciousFinding(f, advisory) {
  return f.malicious || Boolean(advisory?.malicious) || f.osvId.startsWith("MAL-");
}
function matchesOnly(f, advisory, wanted) {
  const ids = [f.osvId, ...f.cves, ...advisory?.aliases ?? [], ...advisory?.cves ?? []].map((s) => s.toUpperCase());
  const hits = ids.filter((id) => wanted.has(id));
  if (wanted.has(f.id.toUpperCase())) hits.push(f.id.toUpperCase());
  return hits;
}
function selectFindings(scan2, verdicts, opts = {}) {
  const only = (opts.only ?? []).map((s) => s.trim()).filter(Boolean);
  const wanted = new Set(only.map((s) => s.toUpperCase()));
  const matched = /* @__PURE__ */ new Set();
  const eligible = [];
  let alreadyCurrent = 0;
  let malicious = 0;
  for (const f of scan2.findings) {
    const advisory = scan2.advisories[f.osvId];
    if (wanted.size) {
      const hits = matchesOnly(f, advisory, wanted);
      if (!hits.length) continue;
      for (const h of hits) matched.add(h);
    }
    if (isMaliciousFinding(f, advisory)) {
      malicious++;
      continue;
    }
    if (!opts.force && verdicts.current(f)) {
      alreadyCurrent++;
      continue;
    }
    eligible.push(f);
  }
  eligible.sort(compareCandidates);
  return { eligible, alreadyCurrent, malicious, unmatched: only.filter((s) => !matched.has(s.toUpperCase())) };
}
var NOT_LOGGED_IN = /\/login|not logged in|log ?in again|invalid api key|authenticat|unauthori[sz]ed|oauth token|\b401\b/i;
var USAGE_LIMIT = /usage limit|hit your [\w -]*limit|limit (reached|exceeded)|resets \d|rate[ _-]?limit|credit balance|quota/i;
var NO_RESULT_ERROR = /^(claude exited |claude stdout is not a JSON object|could not start )/;
function cliMessage(result2) {
  const error62 = result2.error ?? "";
  const raw = result2.raw;
  if (raw && typeof raw.result === "string" && raw.is_error !== true && !NO_RESULT_ERROR.test(error62)) return "";
  return error62;
}
function accountProblem(result2, bin) {
  if (result2.status !== "failed" || !result2.error) return null;
  const error62 = result2.error;
  if (error62.startsWith("could not start ")) return `Could not start \`${bin}\`: is Claude Code installed and on PATH? (${error62})`;
  const message2 = cliMessage(result2);
  if (NOT_LOGGED_IN.test(message2))
    return `Claude Code is not logged in (or the login expired): ${oneLine2(error62)}. Run \`claude\`, log in with /login, then run the audit again.`;
  if (USAGE_LIMIT.test(message2))
    return `Claude Code hit a usage or rate limit: ${oneLine2(error62)}. Wait for the limit to reset, then run triage again.`;
  return null;
}
function repeatedFailureProblem(count, lastError) {
  return `Claude failed for ${count} findings in a row (a usage limit or an outage?). Last error: ${oneLine2(lastError)}. Wait a while (for a usage limit, until it resets), then run triage again.`;
}
function seconds(ms) {
  return `${Math.round(ms / 1e3)}s`;
}
function formatWallTime(ms) {
  const total = Math.round(ms / 1e3);
  if (total < 60) return `${total}s`;
  const m = Math.floor(total / 60);
  const s = total % 60;
  return `${m}m ${String(s).padStart(2, "0")}s`;
}
function packageLabel(f) {
  return `${f.packageName}@${f.installedVersions.join(",") || "?"}`;
}
function oneLine2(s, max = 200) {
  const line = s.replace(/\s+/g, " ").trim();
  return line.length > max ? `${line.slice(0, max - 1)}…` : line;
}
function formatTriageSummary(s) {
  const counts2 = [`${s.ok} ok`, `${s.failed} failed`, ...s.cancelled ? [`${s.cancelled} cancelled`] : []].join(", ");
  const lines = [
    `Triage ${s.interrupted ? "interrupted" : "done"}: ${counts2} in ${formatWallTime(s.wallMs)} · $${s.costUsd.toFixed(2)} at API list price`
  ];
  if (s.stopReason) lines.push(`Stopped early. ${s.stopReason}`);
  if (s.remaining > 0)
    lines.push(
      `${s.remaining} finding${s.remaining === 1 ? "" : "s"} still need${s.remaining === 1 ? "s" : ""} triage; run triage again to continue.`
    );
  if (s.unmatched.length) lines.push(`No finding matched: ${s.unmatched.join(", ")}`);
  return lines;
}
function setupFailure(err, aborted2) {
  return {
    status: aborted2 ? "cancelled" : "failed",
    output: null,
    raw: null,
    modelResolved: null,
    costUsd: null,
    inputTokens: null,
    outputTokens: null,
    cacheReadTokens: null,
    numTurns: null,
    durationMs: null,
    attempts: 0,
    error: aborted2 ? "cancelled" : `setup failed: ${err instanceof Error ? err.message : String(err)}`,
    retriedErrors: [],
    permissionDenials: 0
  };
}
async function prepareSnapshot(scan2, git, signal) {
  const projectDir = import_node_path8.default.dirname(scan2.snapshotDir);
  try {
    return await ensureSnapshot(git, import_node_path8.default.dirname(projectDir), import_node_path8.default.basename(projectDir), scan2.repoRoot, scan2.commit, { signal });
  } catch (err) {
    throw new Error(
      `could not prepare the code snapshot of ${scan2.commit.slice(0, 12)}: ${err instanceof Error ? err.message : String(err)}`,
      {
        cause: err
      }
    );
  }
}
function rescanCommand(ref) {
  return ref === "HEAD" ? "scan" : `scan --ref ${ref}`;
}
function assertScanCurrent(scan2, profile, assetRoot) {
  const tc = scan2.triageConfig;
  const rescan = scan2.ref === "HEAD" ? "run scan again" : `run \`${rescanCommand(scan2.ref)}\` again`;
  const fingerprint = promptFingerprint(tc.promptVersion, assetRoot);
  if (fingerprint !== tc.promptFingerprint) {
    throw new StaleScanError(`the triage prompt changed since the last scan (${tc.promptFingerprint} → ${fingerprint}); ${rescan}`);
  }
  const profileHash = triageProfileHash(profile);
  if (profileHash !== scan2.profileHash) {
    throw new StaleScanError(`.vigiles/profile.yaml changed since the last scan; ${rescan}`);
  }
}
async function runTriage(opts) {
  const { scan: scan2, profile, verdicts, failures } = opts;
  const tc = scan2.triageConfig;
  const log = opts.log ?? (() => {
  });
  const now = opts.now ?? (() => /* @__PURE__ */ new Date());
  const runClaude = opts.runClaude ?? runClaudeTriage;
  const claudeBin = opts.claudeBin ?? bins().claude;
  const git = opts.git ?? bins().git;
  const started = Date.now();
  assertScanCurrent(scan2, profile, opts.assetRoot);
  const selection = selectFindings(scan2, verdicts, { only: opts.only, force: opts.force });
  const limit = opts.limit === void 0 ? Infinity : Math.max(0, opts.limit);
  const candidates = selection.eligible.slice(0, limit);
  const summary = {
    eligible: selection.eligible.length,
    selected: candidates.length,
    ok: 0,
    failed: 0,
    cancelled: 0,
    remaining: selection.eligible.length,
    alreadyCurrent: selection.alreadyCurrent,
    malicious: selection.malicious,
    unmatched: selection.unmatched,
    costUsd: 0,
    wallMs: 0,
    stopReason: null,
    interrupted: false,
    outcomes: []
  };
  if (!candidates.length) {
    summary.wallMs = Date.now() - started;
    return summary;
  }
  const prompt = loadTriagePrompt(opts.assetRoot, tc.promptVersion);
  const ref = auditedRef(scan2);
  let code2 = { access: false };
  let snapshotDir2;
  if (tc.codeAccess) {
    snapshotDir2 = await prepareSnapshot(scan2, git, opts.signal);
    code2 = { access: true, workdir: snapshotDir2, commitSha: scan2.commit, ref, commitDate: scan2.commitDate };
  } else {
    ensureDir(opts.scratchDir);
  }
  const stop = new AbortController();
  const onAbort = () => stop.abort();
  if (opts.signal?.aborted) stop.abort();
  opts.signal?.addEventListener("abort", onAbort, { once: true });
  const concurrency = Math.max(1, opts.concurrency ?? tc.concurrency);
  log(
    `Triaging ${candidates.length} finding${candidates.length === 1 ? "" : "s"} with ${tc.name} (concurrency ${concurrency})` + (selection.alreadyCurrent ? `; ${selection.alreadyCurrent} already have a current verdict` : "")
  );
  let finished = 0;
  let cliFailuresInARow = 0;
  let lastCliError = "";
  try {
    await forEachConcurrent(candidates, concurrency, stop.signal, async (finding) => {
      const t0 = Date.now();
      let result2;
      try {
        const advisory = scan2.advisories[finding.osvId];
        if (!advisory) throw new Error(`advisory ${finding.osvId} is missing from the scan`);
        const userPrompt = renderUserPrompt(prompt.userTemplate, promptInputsFor(finding, advisory, profile, code2));
        result2 = await runClaude({
          bin: claudeBin,
          model: tc.model,
          effort: tc.effort,
          codeAccess: tc.codeAccess,
          systemPrompt: prompt.system,
          schemaJson: prompt.schemaJson,
          maxBudgetUsd: tc.maxBudgetUsd,
          snapshotDir: snapshotDir2,
          scratchDir: opts.scratchDir,
          userPrompt,
          timeoutMs: Math.round(tc.timeoutMinutes * 6e4),
          signal: opts.signal,
          maxAttempts: opts.maxAttempts ?? 2
        });
      } catch (err) {
        result2 = setupFailure(err, Boolean(opts.signal?.aborted));
      }
      const wallMs = Date.now() - t0;
      finished++;
      summary.costUsd += result2.costUsd ?? 0;
      summary.outcomes.push({ findingId: finding.id, status: result2.status, error: result2.error, costUsd: result2.costUsd, wallMs });
      const head = `[${finished}/${candidates.length}]`;
      if (result2.status === "ok" && result2.output) {
        const verdict = {
          osvId: finding.osvId,
          ecosystem: finding.ecosystem,
          packageName: finding.packageName,
          lockfile: finding.lockfile,
          inputHash: finding.inputHash,
          config: tc.name,
          prompt: tc.promptFingerprint,
          model: result2.modelResolved,
          triagedAt: now().toISOString(),
          commit: scan2.commit,
          ref,
          costUsd: result2.costUsd,
          durationMs: result2.durationMs,
          output: result2.output
        };
        verdicts.upsert(verdict);
        verdicts.save(opts.verdictsFile);
        if (failures[finding.id]) {
          delete failures[finding.id];
          saveFailures(opts.failuresFile, failures);
        }
        summary.ok++;
        log(
          `${head} ok ${packageLabel(finding)} ${finding.osvId} → suggests ${ACTION_LABELS[result2.output.suggested_action]} (${result2.output.verdict}, ${seconds(wallMs)})`
        );
        if (result2.attempts > 0) cliFailuresInARow = 0;
        return;
      }
      if (result2.status === "cancelled") {
        summary.cancelled++;
        log(`${head} cancelled ${packageLabel(finding)} ${finding.osvId}`);
        return;
      }
      const error62 = result2.error ?? result2.status;
      failures[finding.id] = { inputHash: finding.inputHash, error: error62, at: now().toISOString() };
      saveFailures(opts.failuresFile, failures);
      summary.failed++;
      log(`${head} failed ${packageLabel(finding)} ${finding.osvId}: ${oneLine2(error62)} (${seconds(wallMs)})`);
      if (result2.status === "failed" && result2.attempts > 0) {
        cliFailuresInARow++;
        lastCliError = error62;
      } else if (result2.attempts > 0) {
        cliFailuresInARow = 0;
      }
      const problem = accountProblem(result2, claudeBin) ?? (cliFailuresInARow >= MAX_CONSECUTIVE_CLI_FAILURES ? repeatedFailureProblem(cliFailuresInARow, lastCliError) : null);
      if (problem && !summary.stopReason) {
        summary.stopReason = problem;
        stop.abort();
      }
    });
  } finally {
    opts.signal?.removeEventListener("abort", onAbort);
  }
  summary.interrupted = Boolean(opts.signal?.aborted);
  summary.remaining = summary.eligible - summary.ok - summary.failed;
  summary.wallMs = Date.now() - started;
  for (const line of formatTriageSummary(summary)) log(line);
  return summary;
}
function interruptSignal(onInterrupt) {
  const controller = new AbortController();
  const handler = (sig) => {
    if (controller.signal.aborted) process.exit(sig === "SIGINT" ? 130 : 143);
    onInterrupt?.();
    controller.abort();
  };
  process.on("SIGINT", handler);
  process.on("SIGTERM", handler);
  return {
    signal: controller.signal,
    dispose: () => {
      process.off("SIGINT", handler);
      process.off("SIGTERM", handler);
    }
  };
}

// src/plugin/decide.ts
function triageStateOf(f, malicious, verdicts, failures) {
  if (malicious) return { status: "skipped", verdict: null, failure: null };
  const verdict = verdicts.current(f);
  if (verdict) return { status: "ok", verdict, failure: null };
  const failure2 = failures[f.id];
  if (failure2 && failure2.inputHash === f.inputHash) return { status: "failed", verdict: null, failure: failure2.error };
  return { status: "pending", verdict: null, failure: null };
}
function decide(scan2, verdicts, failures, policy, profile) {
  const decided = [];
  for (const stored of scan2.findings) {
    const advisory = scan2.advisories[stored.osvId] ?? null;
    const malicious = isMaliciousFinding(stored, advisory);
    const base = computeBasePriority(
      {
        osvId: stored.osvId,
        malicious,
        inKev: stored.inKev,
        kevDateAdded: stored.kevDateAdded,
        epss: stored.epss,
        cvss: stored.cvssScore,
        exposure: profile.exposure,
        criticality: profile.criticality
      },
      policy.policy.thresholds
    );
    const finding = base.priority === stored.priority ? stored : { ...stored, priority: base.priority, priorityReasons: base.reasons };
    const triage2 = triageStateOf(finding, malicious, verdicts, failures);
    const inputs = buildDecisionInputs(
      finding,
      profile,
      { malicious },
      {
        status: triage2.status,
        run: triage2.verdict ? { output: triage2.verdict.output } : null
      }
    );
    const { action, ruleId } = evaluatePolicy(policy.policy, inputs);
    decided.push({
      finding,
      advisory,
      triageStatus: triage2.status,
      verdict: triage2.verdict,
      failure: triage2.failure,
      action,
      ruleId,
      inputs
    });
  }
  if (policy.policy.same_advisory === "max") {
    const rows = decided.map((d) => ({
      finding: { projectId: profile.id, lockfile: d.finding.lockfile, osvId: d.finding.osvId },
      action: d.action,
      ruleId: d.ruleId,
      decided: d
    }));
    raiseToSameAdvisoryMax(rows);
    for (const r of rows) {
      r.decided.action = r.action;
      r.decided.ruleId = r.ruleId;
    }
  }
  const counts2 = { ping: 0, digest: 0, log: 0, untriaged: 0 };
  for (const d of decided) {
    counts2[d.action]++;
    if (d.triageStatus === "pending" || d.triageStatus === "failed") counts2.untriaged++;
  }
  return { policyHash: policy.hash, findings: decided, counts: counts2 };
}


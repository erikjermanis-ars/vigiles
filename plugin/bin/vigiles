var COMMON_OPTIONS = { repo: { type: "string" }, help: { type: "boolean", short: "h" } };
function helpRows(rows, indent) {
  const width = Math.max(0, ...rows.map(([flag]) => flag.length)) + 2;
  return rows.map(([flag, text]) => `${indent}${flag.padEnd(width)}${text}`);
}
function usage(version2, env = process.env) {
  const names = Object.keys(COMMANDS);
  const width = Math.max(...names.map((n) => n.length)) + 2;
  return [
    `vigiles ${version2}: dependency vulnerability audit (the /vigiles:audit Claude Code skill)`,
    "",
    "Usage: vigiles <command> [options]",
    "",
    "Commands:",
    ...names.map((n) => `  ${n.padEnd(width)}${COMMANDS[n].summary}`),
    "",
    "Options:",
    ...helpRows([REPO_HELP, ["-h, --help", "Help for a command (vigiles scan --help)"], ["--version", "Print the version"]], "  "),
    "",
    "Exit codes: 0 ok · 1 error · 2 fix the named input (usage, profile, scan, verdicts.json) · 3 missing prerequisite",
    "Files: commit .vigiles/ (profile.yaml, verdicts.json, .gitignore); .vigiles/report.md is gitignored.",
    `Cache: ${cacheDir(env)} (OSV databases, KEV catalog, code snapshots, last scan).`
  ].join("\n");
}
function commandUsage(name) {
  const def = COMMANDS[name];
  const flags = def.help.map(([flag]) => `[${flag}]`).join(" ");
  return [
    `Usage: vigiles ${name} ${flags ? `${flags} ` : ""}[--repo <path>]`,
    "",
    def.summary,
    "",
    "Options:",
    ...helpRows([...def.help, REPO_HELP], "  ")
  ].join("\n");
}
function parseCommandArgs(name, args) {
  const options = { ...COMMON_OPTIONS, ...COMMANDS[name].options };
  try {
    return (0, import_node_util.parseArgs)({ args, options, strict: true, allowPositionals: false }).values;
  } catch (err) {
    const code2 = err.code;
    const message2 = err instanceof Error ? err.message : String(err);
    const quoted = /'([^']+)'/.exec(message2)?.[1];
    let text;
    if (code2 === "ERR_PARSE_ARGS_UNKNOWN_OPTION") text = `unknown option ${quoted ?? ""} for ${name}`;
    else if (code2 === "ERR_PARSE_ARGS_UNEXPECTED_POSITIONAL") text = `unexpected argument ${quoted ?? ""} for ${name}`;
    else if (code2 === "ERR_PARSE_ARGS_INVALID_OPTION_VALUE") {
      const option = /'(-[\w-]+)/.exec(message2)?.[1] ?? "an option";
      if (/argument missing/.test(message2)) text = `${option} needs a value`;
      else if (/ambiguous/.test(message2)) text = `${option} needs a value (for a value starting with -, write ${option}=<value>)`;
      else if (/does not take an argument/.test(message2)) text = `${option} takes no value`;
      else text = message2;
    } else text = message2;
    throw new CliError(`${text.replace(/\s+/g, " ").trim()}; see \`vigiles ${name} --help\``);
  }
}
function stringOpt(values, key) {
  const v = values[key];
  return typeof v === "string" ? v : void 0;
}
function boolOpt(values, key) {
  return values[key] === true;
}
function intOpt(values, key, min, max = Number.MAX_SAFE_INTEGER) {
  const raw = stringOpt(values, key);
  if (raw === void 0) return void 0;
  if (!/^\d+$/.test(raw.trim()) || Number(raw) < min || Number(raw) > max) {
    throw new CliError(
      `--${key} must be a whole number${max < Number.MAX_SAFE_INTEGER ? ` from ${min} to ${max}` : ` of at least ${min}`} (got "${raw}")`
    );
  }
  return Number(raw);
}
function listOpt(values, key) {
  const v = values[key];
  if (v === void 0) return void 0;
  const items = (Array.isArray(v) ? v : [v]).filter((x) => typeof x === "string").flatMap((x) => x.split(",")).map((x) => x.trim()).filter(Boolean);
  if (!items.length) throw new CliError(`--${key} needs at least one id`);
  return items;
}
function errorCode2(err) {
  for (let e = err; e; e = e.cause) {
    const code2 = e.code;
    if (code2) return code2;
  }
  return void 0;
}
function message(err) {
  return err instanceof Error ? err.message : String(err);
}
async function resolveRepo(ctx, values) {
  const dir = import_node_path17.default.resolve(ctx.cwd, stringOpt(values, "repo") ?? ".");
  if (!(0, import_node_fs15.existsSync)(dir)) throw new CliError(`${dir} does not exist`);
  try {
    return await findRepoRoot(dir, ctx.bins.git);
  } catch (err) {
    if (errorCode2(err) === "ENOENT") throw new CliError(`git not found (${ctx.bins.git}); install git`, EXIT.prerequisite);
    throw new CliError(message(err));
  }
}
function profileFile(repoRoot2) {
  return import_node_path17.default.join(repoRoot2, ".vigiles", "profile.yaml");
}
function ensureVigilesGitignore(vigilesDir) {
  assertRealDirectory(vigilesDir);
  const file2 = import_node_path17.default.join(vigilesDir, ".gitignore");
  if ((0, import_node_fs15.existsSync)(file2)) return false;
  (0, import_node_fs15.mkdirSync)(vigilesDir, { recursive: true });
  writeRepoFile(file2, VIGILES_GITIGNORE);
  return true;
}
function shown(ctx, file2) {
  const rel = import_node_path17.default.relative(ctx.cwd, file2);
  return rel && !rel.startsWith("..") && !import_node_path17.default.isAbsolute(rel) ? rel : file2;
}
function refText(scan2) {
  if (scan2.ref === "HEAD") return scan2.branch ? `HEAD (${scan2.branch})` : "detached HEAD";
  return scan2.ref;
}
function plural3(n, one, many = `${one}s`) {
  return `${n.toLocaleString("en-US")} ${n === 1 ? one : many}`;
}
async function loadState(ctx, values) {
  const repoRoot2 = await resolveRepo(ctx, values);
  const plugin = ctx.plugin();
  const { profile, warnings: profileWarnings } = loadProfile(profileFile(repoRoot2));
  const paths = repoPaths(repoRoot2, profile.id, plugin);
  let scan2;
  try {
    scan2 = readScanResult(paths.scanFile);
  } catch (err) {
    throw new CliError(`the last scan cannot be read (${message(err)}); run \`vigiles scan\` again`);
  }
  if (!scan2) throw new CliError("no scan of this repository yet; run `vigiles scan` first");
  let loaded;
  try {
    loaded = loadVerdicts(paths.verdictsFile);
  } catch (err) {
    throw new CliError(message(err));
  }
  return {
    repoRoot: repoRoot2,
    plugin,
    profile,
    profileWarnings,
    paths,
    scan: scan2,
    verdicts: loaded.store,
    verdictWarnings: loaded.warnings,
    failures: loadFailures(paths.failuresFile)
  };
}
function summarizeScan(scan2, verdicts, failures) {
  const selection = selectFindings(scan2, verdicts);
  const byPriority = Object.fromEntries(PRIORITIES.map((p) => [p, 0]));
  for (const f of scan2.findings) byPriority[f.priority]++;
  const n = selection.eligible.length;
  const concurrency = Math.max(1, scan2.triageConfig.concurrency);
  return {
    ref: scan2.ref,
    branch: scan2.branch,
    commit: scan2.commit,
    commitDate: scan2.commitDate,
    lockfiles: scan2.lockfiles,
    skippedLockfiles: scan2.skippedLockfiles,
    manifestsWithoutLockfile: scan2.coverageGaps.filter((g) => !scan2.skippedLockfiles.includes(g)),
    packages: scan2.stats.packages,
    findings: scan2.findings.length,
    vulnerablePackages: scan2.stats.vulnerablePackages,
    byPriority,
    current: selection.alreadyCurrent,
    toTriage: n,
    changed: selection.eligible.filter((f) => verdicts.get(f)).length,
    failedBefore: selection.eligible.filter((f) => failures[f.id]?.inputHash === f.inputHash).length,
    malicious: selection.malicious,
    estimate: {
      findings: n,
      usd: Math.round(n * TRIAGE_ESTIMATE.usdPerFinding * 100) / 100,
      seconds: Math.ceil(n / concurrency) * TRIAGE_ESTIMATE.secondsPerFinding,
      concurrency
    },
    warnings: scan2.warnings
  };
}
function aboutDuration(seconds2) {
  if (seconds2 < 60) return "under a minute";
  const minutes = Math.round(seconds2 / 60);
  return minutes < 90 ? `about ${minutes} min` : `about ${(seconds2 / 3600).toFixed(1)} h`;
}
function aboutUsd(usd) {
  return usd >= 10 ? `$${Math.round(usd)}` : `$${usd.toFixed(2)}`;
}
function formatScanSummary(s) {
  const committed = s.commitDate ? ` (committed ${shortDate(s.commitDate, "UTC")})` : "";
  const lines = [
    `Audited ${refText(s)} at ${s.commit.slice(0, 10)}${committed}: ${plural3(s.lockfiles.length, "lockfile")}, ${plural3(s.packages, "package")}`
  ];
  if (s.lockfiles.length) lines.push(`  lockfiles: ${s.lockfiles.join(", ")}`);
  if (s.skippedLockfiles.length) lines.push(`  skipped (not audited): ${s.skippedLockfiles.join(", ")}`);
  if (s.manifestsWithoutLockfile.length) lines.push(`  no lockfile (not audited): ${s.manifestsWithoutLockfile.join(", ")}`);
  if (!s.findings) {
    lines.push("Findings: none. No known vulnerabilities in the audited lockfiles.");
  } else {
    const prio = PRIORITIES.map((p) => `${p} ${s.byPriority[p]}`).join(" · ");
    lines.push(`Findings: ${s.findings} in ${plural3(s.vulnerablePackages, "package")} (${prio})`);
    const detail = [
      ...s.changed ? [`${s.changed} changed since their verdict`] : [],
      ...s.failedBefore ? [`${s.failedBefore} failed last time`] : []
    ];
    lines.push(
      `Verdicts: ${s.current} cached (current) · ${s.toTriage} to triage${detail.length ? ` (${detail.join(", ")})` : ""}` + (s.malicious ? ` · ${s.malicious} malicious (never triaged; always Fix now)` : "")
    );
    if (s.toTriage) {
      const e = s.estimate;
      lines.push(
        `Estimate: ${plural3(e.findings, "finding")}, ${aboutDuration(e.seconds)} (${e.concurrency} at a time), about ${aboutUsd(e.usd)} of Claude usage at API list prices`
      );
    }
  }
  if (s.warnings.length) lines.push("Warnings:", ...s.warnings.map((w) => `  - ${w.replace(/\s+/g, " ")}`));
  lines.push(
    s.toTriage ? "Next: `vigiles triage` (--limit <n> for the most urgent first), then `vigiles report`" : "Next: `vigiles report`"
  );
  return lines;
}
async function versionOf(bin, args, env) {
  try {
    const r = await runProcess(bin, args, { timeoutMs: 2e4, env });
    const text = `${r.stdout}
${r.stderr}`.trim().split("\n")[0].trim();
    if (r.code !== 0) return { ok: false, reason: `exited ${r.code ?? r.signal}${text ? `: ${text}` : ""}` };
    return { ok: true, text };
  } catch (err) {
    return { ok: false, reason: errorCode2(err) === "ENOENT" ? "not found" : message(err) };
  }
}
function semver(text) {
  const m = /(\d+)\.(\d+)\.(\d+)/.exec(text);
  return m ? { text: m[0], major: Number(m[1]) } : null;
}
async function claudeLogin(bin) {
  let r;
  try {
    r = await runProcess(bin, ["auth", "status", "--json"], { timeoutMs: 2e4, env: minimalEnv() });
  } catch (err) {
    return { status: "warn", detail: `could not check (${message(err)})` };
  }
  let status;
  try {
    status = JSON.parse(r.stdout);
  } catch {
    const text = `${r.stdout}
${r.stderr}`.trim().split("\n")[0] ?? "";
    return { status: "warn", detail: `could not check (\`claude auth status\` said: ${text.slice(0, 160) || `exit ${r.code}`})` };
  }
  if (status.loggedIn === true) {
    const how = [status.authMethod, status.subscriptionType].filter((x) => typeof x === "string" && x !== "");
    return { status: "ok", detail: `logged in${how.length ? ` (${how.join(", ")})` : ""}` };
  }
  return {
    status: "missing",
    detail: "not logged in; run `claude` in a terminal and log in with /login (triage runs claude without API keys from your shell)"
  };
}
function cachedOsvDatabases(osvDbDir, now) {
  let ecosystems;
  try {
    ecosystems = (0, import_node_fs15.readdirSync)(import_node_path17.default.join(osvDbDir, "osv-scalibr")).filter(
      (e) => (0, import_node_fs15.existsSync)(import_node_path17.default.join(osvDbDir, "osv-scalibr", e, "all.zip"))
    );
  } catch {
    ecosystems = [];
  }
  if (!ecosystems.length) return "none downloaded yet; the first scan downloads what the lockfiles need (npm is about 200 MB)";
  return ecosystems.sort().map((e) => {
    const checked = readSidecar(osvDbDir, e).checkedAt;
    return checked ? `${e} (checked ${relativeTime(checked, now)})` : e;
  }).join(", ");
}
async function doctorCommand(ctx, values) {
  let prerequisiteMissing = false;
  let inputProblem = false;
  const line = (status, check2, detail) => {
    if (status === "missing") prerequisiteMissing = true;
    ctx.out(`${status} ${check2}: ${detail}`);
  };
  const node2 = process.versions.node;
  if (Number(node2.split(".")[0]) >= 20) line("ok", "node", node2);
  else line("missing", "node", `${node2}; Vigiles needs Node.js 20 or newer`);
  let plugin = null;
  try {
    plugin = ctx.plugin();
    const tc = loadTriageConfig(plugin.assetRoot);
    line("ok", "vigiles", `${ctx.version} (triage ${tc.name}, prompt ${tc.promptFingerprint})`);
  } catch (err) {
    line("missing", "vigiles", `the plugin's files are incomplete: ${message(err)}; reinstall the plugin`);
  }
  const git = await versionOf(ctx.bins.git, ["--version"]);
  if (git.ok) line("ok", "git", semver(git.text)?.text ?? git.text);
  else line("missing", "git", `${git.reason} (${ctx.bins.git}); install git`);
  const osv = await versionOf(ctx.bins.osvScanner, ["--version"]);
  const osvVersion = osv.ok ? semver(osv.text) : null;
  if (!osv.ok) {
    line(
      "missing",
      "osv-scanner",
      `${osv.reason} (${ctx.bins.osvScanner}); install it: \`brew install osv-scanner\` or https://google.github.io/osv-scanner/installation/`
    );
  } else if (osvVersion && osvVersion.major < 2) {
    line("missing", "osv-scanner", `${osvVersion.text}; Vigiles needs osv-scanner 2 or newer (\`brew upgrade osv-scanner\`)`);
  } else {
    line("ok", "osv-scanner", osvVersion?.text ?? osv.text);
  }
  const claude = await versionOf(ctx.bins.claude, ["--version"], minimalEnv());
  if (!claude.ok) {
    line("missing", "claude", `${claude.reason} (${ctx.bins.claude}); install Claude Code: https://claude.com/claude-code`);
  } else {
    line("ok", "claude", semver(claude.text)?.text ?? claude.text);
    const login = await claudeLogin(ctx.bins.claude);
    line(login.status, "claude login", login.detail);
  }
  const cache = plugin?.cacheDir ?? cacheDir(ctx.env);
  try {
    ensureDir(cache);
    const probe = import_node_path17.default.join(cache, `.write-test-${process.pid}`);
    (0, import_node_fs15.writeFileSync)(probe, "");
    (0, import_node_fs15.rmSync)(probe, { force: true });
    line("ok", "cache", `${cache} (writable)`);
    if (plugin) line("ok", "osv databases", cachedOsvDatabases(plugin.osvDbDir, ctx.now()));
  } catch (err) {
    line("missing", "cache", `${cache} is not writable (${message(err)}); set VIGILES_CACHE_DIR to a writable directory`);
  }
  let repoRoot2 = null;
  try {
    repoRoot2 = await resolveRepo(ctx, values);
  } catch (err) {
    if (err instanceof CliError && err.exitCode === EXIT.prerequisite) {
    } else {
      inputProblem = true;
      ctx.out(`missing repository: ${message(err)}; run Vigiles inside the repository to audit`);
    }
  }
  if (repoRoot2) {
    const branch = await currentBranch(ctx.bins.git, repoRoot2).catch(() => null);
    const head = await gitResolveRef(ctx.bins.git, repoRoot2, "HEAD").catch(() => null);
    if (head) line("ok", "repository", `${repoRoot2} (${branch ?? "detached HEAD"} @ ${head.sha.slice(0, 7)})`);
    else line("warn", "repository", `${repoRoot2} has no commit yet; Vigiles audits committed lockfiles`);
    try {
      const { profile, warnings } = loadProfile(profileFile(repoRoot2));
      line("ok", "profile", `.vigiles/profile.yaml (${profile.id}: ${profile.exposure}, criticality ${profile.criticality})`);
      for (const w of warnings) line("warn", "profile", w.replace(/^profile: /, ""));
      if (plugin) {
        const scan2 = (() => {
          try {
            return readScanResult(repoPaths(repoRoot2, profile.id, plugin).scanFile);
          } catch {
            return null;
          }
        })();
        if (scan2) {
          line(
            "ok",
            "last scan",
            `${refText(scan2)} @ ${scan2.commit.slice(0, 7)}, ${relativeTime(scan2.scannedAt, ctx.now())}: ${plural3(scan2.findings.length, "finding")}`
          );
        }
      }
    } catch (err) {
      if (err instanceof ProfileMissingError) {
        ctx.out("missing profile: no .vigiles/profile.yaml yet; run `vigiles init` to create one");
      } else {
        const lines = message(err).split("\n");
        const detail = (lines[1] ?? lines[0] ?? "").trim().replace(/^Invalid \S+: /, "");
        ctx.out(`warn profile: invalid (${detail}); run \`vigiles profile\` for details`);
      }
    }
  }
  if (prerequisiteMissing) return EXIT.prerequisite;
  return inputProblem ? EXIT.input : EXIT.ok;
}
async function initCommand(ctx, values) {
  const repoRoot2 = await resolveRepo(ctx, values);
  const vigilesDir = import_node_path17.default.join(repoRoot2, ".vigiles");
  assertRealDirectory(vigilesDir);
  const createdDir = !(0, import_node_fs15.existsSync)(vigilesDir);
  (0, import_node_fs15.mkdirSync)(vigilesDir, { recursive: true });
  const createdIgnore = ensureVigilesGitignore(vigilesDir);
  const file2 = profileFile(repoRoot2);
  const exists = (0, import_node_fs15.existsSync)(file2);
  const created = [...createdDir ? [".vigiles/"] : [], ...createdIgnore ? [".vigiles/.gitignore (ignores report.md)"] : []];
  if (created.length) ctx.out(`Created ${created.join(" and ")}.`);
  if (exists) {
    ctx.out(`${shown(ctx, file2)} already exists and was not changed; run \`vigiles profile\` to check it.`);
  } else {
    ctx.out(`No profile yet. Write ${shown(ctx, file2)} from the template below: replace every TODO, then run \`vigiles profile\`.`);
  }
  const facts = await detectFacts(repoRoot2, ctx.bins.git);
  ctx.out("", "## Detected at HEAD", "", formatFacts(facts));
  ctx.out("", exists ? "## Profile template (for reference)" : "## Profile template", "", profileTemplate(facts).trimEnd());
  return EXIT.ok;
}
async function profileCommand(ctx, values) {
  const repoRoot2 = await resolveRepo(ctx, values);
  const file2 = profileFile(repoRoot2);
  const { profile, warnings } = loadProfile(file2);
  const hash2 = triageProfileHash(toProjectProfile(profile, repoRoot2));
  const list = (items) => items.length ? items.join(", ") : "none";
  ctx.out(
    `${shown(ctx, file2)} is valid.`,
    `  id: ${profile.id} · name: ${profile.name} · production branch: ${profile.ref}`,
    `  exposure: ${profile.exposure} · criticality: ${profile.criticality} · data classes: ${list(profile.data_classes)}`,
    `  deployments: ${profile.deployments.length} · third-party services: ${list(profile.third_party_services)}`,
    `  triage profile hash: ${hash2} (verdicts are reused while it stays the same)`
  );
  for (const w of warnings) ctx.out(`warn: ${w.replace(/^profile: /, "")}`);
  let scan2 = null;
  try {
    scan2 = readScanResult(repoPaths(repoRoot2, profile.id, ctx.plugin()).scanFile);
  } catch {
    scan2 = null;
  }
  if (scan2 && scan2.profileHash !== hash2) {
    ctx.out("Changed since the last scan: run `vigiles scan`; findings are triaged again under the new profile.");
  }
  return EXIT.ok;
}
function refArg(values) {
  const ref = stringOpt(values, "ref");
  if (ref === void 0) return void 0;
  try {
    assertSafeRef(ref);
  } catch (err) {
    throw new CliError(message(err));
  }
  return ref;
}
async function scan(ctx, values) {
  const ref = refArg(values);
  const repoRoot2 = await resolveRepo(ctx, values);
  const plugin = ctx.plugin();
  let result2;
  try {
    result2 = await runScan({
      repoRoot: repoRoot2,
      plugin,
      toolVersion: ctx.version,
      ref,
      fetch: boolOpt(values, "fetch"),
      refreshDb: boolOpt(values, "refresh-db"),
      bins: ctx.bins,
      signal: ctx.signal,
      progress: (l) => ctx.err(`· ${l}`),
      ...ctx.deps.scan
    });
  } catch (err) {
    if (err instanceof ProfileMissingError || err instanceof ProfileInvalidError || ctx.signal?.aborted) throw err;
    if (err instanceof InvalidRefError) throw new CliError(message(err));
    if (message(err).startsWith("osv-scanner not found")) throw new CliError(message(err), EXIT.prerequisite);
    if (message(err).startsWith("cannot resolve ")) throw new CliError(message(err));
    throw err;
  }
  const paths = repoPaths(repoRoot2, result2.projectId, plugin);
  const { store } = loadVerdictsOrFail(paths.verdictsFile);
  return { result: result2, summary: summarizeScan(result2, store, loadFailures(paths.failuresFile)) };
}
function loadVerdictsOrFail(file2) {
  try {
    return loadVerdicts(file2);
  } catch (err) {
    throw new CliError(message(err));
  }
}
async function scanCommand(ctx, values) {
  const { summary } = await scan(ctx, values);
  if (boolOpt(values, "json")) ctx.out(JSON.stringify(summary, null, 2));
  else ctx.out(...formatScanSummary(summary));
  return EXIT.ok;
}
function triageArgs(values) {
  return {
    limit: intOpt(values, "limit", 0),
    only: listOpt(values, "only"),
    force: boolOpt(values, "force"),
    concurrency: intOpt(values, "concurrency", 1, 10)
  };
}
async function triage(ctx, values, args) {
  const state = await loadState(ctx, values);
  const { scan: scan2, paths } = state;
  for (const w of state.verdictWarnings) ctx.err(`warning: ${w}`);
  const { only } = args;
  ensureVigilesGitignore(paths.vigilesDir);
  ctx.out(`Triage of ${refText(scan2)} @ ${scan2.commit.slice(0, 7)} (scanned ${relativeTime(scan2.scannedAt, ctx.now())})`);
  const summary = await runTriage({
    scan: scan2,
    profile: toProjectProfile(state.profile, state.repoRoot),
    assetRoot: state.plugin.assetRoot,
    verdicts: state.verdicts,
    verdictsFile: paths.verdictsFile,
    failures: state.failures,
    failuresFile: paths.failuresFile,
    scratchDir: state.plugin.scratchDir,
    git: ctx.bins.git,
    claudeBin: ctx.bins.claude,
    limit: args.limit,
    only,
    force: args.force,
    concurrency: args.concurrency,
    signal: ctx.signal,
    log: (l) => ctx.out(l),
    runClaude: ctx.deps.runClaude,
    now: ctx.now
  });
  if (summary.selected === 0) {
    if (summary.unmatched.length) ctx.out(`No finding matched: ${summary.unmatched.join(", ")}`);
    if (only && summary.unmatched.length === only.length) return { summary, exitCode: EXIT.input };
    if (summary.eligible > 0) {
      ctx.out(`Nothing triaged (--limit 0); ${plural3(summary.eligible, "finding")} still need triage.`);
    } else {
      const parts = [
        `${plural3(summary.alreadyCurrent, "finding")} already ${summary.alreadyCurrent === 1 ? "has" : "have"} a current verdict`,
        ...summary.malicious ? [`${summary.malicious} malicious (never triaged)`] : []
      ];
      ctx.out(`Nothing to triage: ${parts.join("; ")}.`);
    }
  }
  if (summary.interrupted) return { summary, exitCode: EXIT.interrupted };
  if (summary.stopReason) return { summary, exitCode: EXIT.prerequisite };
  return { summary, exitCode: EXIT.ok };
}
async function triageCommand(ctx, values) {
  const { exitCode } = await triage(ctx, values, triageArgs(values));
  if (exitCode === EXIT.ok || exitCode === EXIT.prerequisite) ctx.out("Next: `vigiles report`");
  return exitCode;
}
async function staleness(ctx, state) {
  const out = [];
  try {
    assertScanCurrent(state.scan, toProjectProfile(state.profile, state.repoRoot), state.plugin.assetRoot);
  } catch (err) {
    if (!(err instanceof StaleScanError)) throw err;
    out.push(`${message(err)}; verdicts are checked against the inputs of the last scan until then.`);
  }
  try {
    const { ref } = state.scan;
    const now = await gitResolveRef(ctx.bins.git, state.repoRoot, ref);
    if (now.sha !== state.scan.commit) {
      out.push(
        `${ref} is now at ${now.sha.slice(0, 7)}, but this report is for the scanned commit ${state.scan.commit.slice(0, 7)}; run \`${rescanCommand(ref)}\` to audit the new commit.`
      );
    }
  } catch {
  }
  return out;
}
async function report(ctx, values) {
  const state = await loadState(ctx, values);
  const policy = loadPolicy(state.plugin.assetRoot);
  const decisions = decide(state.scan, state.verdicts, state.failures, policy, state.profile);
  const markdown = renderReport({
    scan: state.scan,
    decisions,
    profile: state.profile,
    generatedAt: ctx.now().toISOString(),
    toolVersion: ctx.version,
    warnings: [...state.profileWarnings, ...state.verdictWarnings, ...await staleness(ctx, state)]
  });
  ensureVigilesGitignore(state.paths.vigilesDir);
  writeRepoFile(state.paths.reportFile, markdown);
  ctx.out(renderSummary(decisions, state.scan, shown(ctx, state.paths.reportFile)));
  return EXIT.ok;
}
async function reportCommand(ctx, values) {
  return report(ctx, values);
}
async function auditCommand(ctx, values) {
  const args = triageArgs(values);
  refArg(values);
  const { summary } = await scan(ctx, values);
  ctx.out(...formatScanSummary(summary).filter((l) => !l.startsWith("Next: ")), "");
  let exitCode = EXIT.ok;
  if (summary.toTriage > 0) {
    const result2 = await triage(ctx, values, args);
    exitCode = result2.exitCode;
    if (exitCode === EXIT.interrupted || exitCode === EXIT.input) return exitCode;
    ctx.out("");
  }
  await report(ctx, values);
  return exitCode;
}
async function main(argv, deps = {}) {
  const env = deps.env ?? process.env;
  const out = deps.stdout ?? ((l) => process.stdout.write(`${l}
`));
  const err = deps.stderr ?? ((l) => process.stderr.write(`${l}
`));
  let assetRoot = deps.assetRoot ?? null;
  const resolveAssetRoot = () => {
    if (assetRoot) return assetRoot;
    try {
      assetRoot = findAssetRoot(void 0, env);
    } catch (e) {
      throw new CliError(`${message(e)}; reinstall the plugin`, EXIT.prerequisite);
    }
    return assetRoot;
  };
  const version2 = toolVersion(
    (() => {
      try {
        return resolveAssetRoot();
      } catch {
        return null;
      }
    })()
  );
  const [command, ...rest] = argv;
  if (command === void 0) {
    err(usage(version2, env));
    return EXIT.input;
  }
  if (command === "--version" || command === "-V" || command === "version") {
    out(`vigiles ${version2}`);
    return EXIT.ok;
  }
  if (command === "--help" || command === "-h" || command === "help") {
    const topic = rest[0];
    out(topic && COMMANDS[topic] ? commandUsage(topic) : usage(version2, env));
    return EXIT.ok;
  }
  const def = COMMANDS[command];
  if (!def) {
    err(`vigiles: unknown ${command.startsWith("-") ? "option" : "command"} ${command}; run \`vigiles --help\``);
    return EXIT.input;
  }
  let interrupt = null;
  const ctx = {
    cwd: deps.cwd ?? process.cwd(),
    env,
    out: (...lines) => lines.forEach((l) => out(l)),
    err: (...lines) => lines.forEach((l) => err(l)),
    bins: bins(env),
    deps,
    now: deps.now ?? (() => /* @__PURE__ */ new Date()),
    version: version2,
    plugin: () => pluginPaths({ assetRoot: resolveAssetRoot(), env })
  };
  try {
    const values = parseCommandArgs(command, rest);
    if (values.help) {
      out(commandUsage(command));
      return EXIT.ok;
    }
    if (deps.signal) {
      ctx.signal = deps.signal;
    } else if (command === "scan" || command === "triage" || command === "audit") {
      interrupt = interruptSignal(
        () => err("vigiles: interrupted; stopping (verdicts saved so far are kept). Press Ctrl-C again to quit at once.")
      );
      ctx.signal = interrupt.signal;
    }
    return await def.run(ctx, values);
  } catch (e) {
    if (ctx.signal?.aborted) {
      err("vigiles: interrupted");
      return EXIT.interrupted;
    }
    if (e instanceof CliError) {
      err(`vigiles: ${e.message}`);
      return e.exitCode;
    }
    if (e instanceof ProfileMissingError || e instanceof ProfileInvalidError || e instanceof StaleScanError || e instanceof UnsafeRepoFileError) {
      err(`vigiles: ${e.message}`);
      return EXIT.input;
    }
    err(`vigiles: error: ${message(e)}`);
    if (env.VIGILES_DEBUG && e instanceof Error && e.stack) err(e.stack);
    return EXIT.error;
  } finally {
    interrupt?.dispose();
  }
}

// src/plugin/main.ts
for (const stream of [process.stdout, process.stderr]) {
  stream.on("error", (err) => {
    if (err.code !== "EPIPE") throw err;
  });
}
void main(process.argv.slice(2)).then((code2) => {
  process.exitCode = code2;
  setTimeout(() => process.exit(code2), 200).unref();
});

async function runOnce2(opts, lockfiles) {
  const outputFile = import_node_path15.default.join(opts.scratchDir, `osv-scanner-${process.pid}-${Date.now()}.json`);
  const timeoutMs = opts.timeoutMs ?? DEFAULT_TIMEOUT_MS;
  try {
    const r = await runProcess(opts.bin, osvScannerArgs(lockfiles, outputFile, opts.configFile), {
      // It needs no credentials, and it parses lockfiles from client repos.
      env: minimalEnv({ OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY: opts.osvDbDir }),
      signal: opts.signal,
      timeoutMs
    });
    if (r.aborted) throw new Error("osv-scanner was cancelled");
    if (r.timedOut) throw new Error(`osv-scanner timed out after ${Math.round(timeoutMs / 1e3)}s`);
    const stderr = r.stderr.trim();
    if (r.code === null || !OK_EXIT_CODES.has(r.code)) {
      const unsupported = unsupportedLockfile(stderr, lockfiles);
      if (unsupported) return { kind: "unsupported", lockfile: unsupported, durationMs: r.durationMs };
      throw new Error(`osv-scanner exited ${r.code ?? r.signal}: ${stderr.slice(0, 2e3) || r.stdout.trim().slice(0, 2e3)}`);
    }
    if (!(0, import_node_fs12.existsSync)(outputFile)) {
      if (r.code === 128) return { kind: "ok", run: { results: [], durationMs: r.durationMs, exitCode: r.code, warnings: stderr } };
      throw new Error(`osv-scanner exited ${r.code} without writing ${outputFile}: ${stderr.slice(0, 2e3)}`);
    }
    const results = parseOsvOutput(JSON.parse((0, import_node_fs12.readFileSync)(outputFile, "utf8")));
    return { kind: "ok", run: { results, durationMs: r.durationMs, exitCode: r.code, warnings: stderr.slice(0, 4e3) } };
  } finally {
    (0, import_node_fs12.rmSync)(outputFile, { force: true });
  }
}
async function runOsvScanner(opts) {
  let remaining = [...opts.lockfiles];
  const unsupported = [];
  let spentMs = 0;
  while (remaining.length > 0) {
    const r = await runOnce2(opts, remaining);
    if (r.kind === "ok") return { ...r.run, durationMs: spentMs + r.run.durationMs, unsupported };
    spentMs += r.durationMs;
    unsupported.push(r.lockfile);
    remaining = remaining.filter((l) => l !== r.lockfile);
  }
  return { results: [], durationMs: spentMs, exitCode: 0, warnings: "", unsupported };
}


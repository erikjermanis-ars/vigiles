// src/lib/policy/same-advisory.ts
var ACTION_RANK = { log: 0, digest: 1, ping: 2 };
var SAME_ADVISORY_RULE = "same-advisory";
function raiseToSameAdvisoryMax(rows) {
  const best = /* @__PURE__ */ new Map();
  const key = (r) => `${r.finding.projectId}\0${r.finding.lockfile}\0${r.finding.osvId}`;
  for (const r of rows) {
    const k = key(r);
    const b = best.get(k);
    if (!b || ACTION_RANK[r.action] > ACTION_RANK[b]) best.set(k, r.action);
  }
  for (const r of rows) {
    const b = best.get(key(r));
    if (ACTION_RANK[b] > ACTION_RANK[r.action]) {
      r.action = b;
      r.ruleId = SAME_ADVISORY_RULE;
    }
  }
  return rows;
}


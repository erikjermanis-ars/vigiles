async function ensureSnapshot(git, snapshotsRoot, projectId, repoPath, sha, opts = {}) {
  if (!/^[0-9a-f]{4,64}$/i.test(sha)) throw new Error(`ensureSnapshot: not a commit sha: ${JSON.stringify(sha)}`);
  const dir = snapshotDir(snapshotsRoot, projectId, sha);
  if (isCompleteSnapshot(dir, sha, opts.log)) return dir;
  (0, import_node_fs2.mkdirSync)(import_node_path2.default.dirname(dir), { recursive: true, mode: 448 });
  const tmp = (0, import_node_fs2.mkdtempSync)(`${dir}.tmp-`);
  try {
    const info = await writeTreeFromObjects(git, repoPath, sha, tmp, opts);
    (0, import_node_fs2.writeFileSync)(import_node_path2.default.join(tmp, COMPLETE_MARKER), `${JSON.stringify(info)}
`, { mode: 384 });
    const summary = describeSkipped(info);
    if (summary) opts.log?.(summary);
    publishSnapshot(tmp, dir);
    return dir;
  } finally {
    (0, import_node_fs2.rmSync)(tmp, { recursive: true, force: true });
  }
}
function isCompleteSnapshot(dir, sha, log) {
  const marker = import_node_path2.default.join(dir, COMPLETE_MARKER);
  let raw;
  try {
    raw = (0, import_node_fs2.readFileSync)(marker, "utf8");
  } catch {
    return false;
  }
  let previous = null;
  try {
    const parsed = JSON.parse(raw);
    if (parsed?.format === SNAPSHOT_FORMAT) return true;
    if (parsed && typeof parsed === "object") previous = parsed;
  } catch {
  }
  scrubSnapshot(dir);
  const info = previous ? { ...previous, format: SNAPSHOT_FORMAT } : { format: SNAPSHOT_FORMAT, sha, source: "archive" };
  const tmpMarker = `${marker}.${process.pid}-${Math.random().toString(36).slice(2)}`;
  (0, import_node_fs2.writeFileSync)(tmpMarker, `${JSON.stringify(info)}
`, { mode: 384 });
  (0, import_node_fs2.renameSync)(tmpMarker, marker);
  log?.(`snapshot ${sha.slice(0, 10)}: re-scrubbed a${previous ? `n older (format ${previous.format})` : " legacy git-archive"} snapshot`);
  return true;
}
function errCode(err) {
  return err?.code;
}
function publishSnapshot(tmp, dir) {
  for (let attempt = 0; ; attempt++) {
    try {
      (0, import_node_fs2.renameSync)(tmp, dir);
      return;
    } catch (err) {
      if (!["ENOTEMPTY", "EEXIST", "ENOTDIR"].includes(errCode(err) ?? "")) throw err;
      if ((0, import_node_fs2.existsSync)(import_node_path2.default.join(dir, COMPLETE_MARKER))) return;
      if (attempt >= 2) throw err;
      (0, import_node_fs2.rmSync)(dir, { recursive: true, force: true });
    }
  }
}
function describeSkipped(info) {
  const s = info.skipped;
  if (!s) return null;
  const parts = [
    s.symlinks && `${s.symlinks} symlink(s)`,
    s.submodules && `${s.submodules} submodule(s)`,
    s.unsafe && `${s.unsafe} unsafe path(s)`,
    s.unwritable && `${s.unwritable} unwritable path(s)`,
    s.scrubbed && `${s.scrubbed} .git/.claude/.vigiles/.env* path(s)`
  ].filter(Boolean);
  if (!parts.length) return null;
  const examples = info.skippedExamples?.length ? ` (e.g. ${info.skippedExamples.slice(0, 5).join(", ")})` : "";
  return `snapshot ${info.sha.slice(0, 10)}: not written: ${parts.join(", ")}${examples}`;
}
async function writeTreeFromObjects(git, repoPath, sha, dest, opts) {
  const ls = await runChecked(git, ["-C", repoPath, "ls-tree", "-r", "-z", sha], {
    env: GIT_ENV,
    timeoutMs: 6e4,
    signal: opts.signal,
    maxBuffer: 1024 * 1024 * 1024
  });
  const skipped = { symlinks: 0, submodules: 0, scrubbed: 0, unsafe: 0, unwritable: 0 };
  const examples = [];
  const skip = (kind, file2, why = kind) => {
    skipped[kind]++;
    if (kind !== "scrubbed" && examples.length < MAX_SKIPPED_EXAMPLES) examples.push(`${file2} (${why})`);
  };
  const blobs = [];
  for (const record2 of ls.stdout.split("\0")) {
    if (!record2) continue;
    const tab = record2.indexOf("	");
    const [mode = "", type = "", oid = ""] = (tab === -1 ? record2 : record2.slice(0, tab)).split(" ");
    const file2 = tab === -1 ? "" : record2.slice(tab + 1);
    if (tab === -1 || !/^[0-9a-f]{40,64}$/.test(oid)) throw new Error(`git ls-tree: unexpected output: ${record2.slice(0, 200)}`);
    if (isUnsafePath(file2)) skip("unsafe", JSON.stringify(file2), "unsafe path");
    else if (isScrubbedPath(file2)) skip("scrubbed", file2);
    else if (isReservedPath(file2)) skip("unsafe", file2, "reserved name");
    else if (mode === "120000") skip("symlinks", file2, "symlink");
    else if (mode === "160000" || type === "commit") skip("submodules", file2, "submodule");
    else if (type === "blob" && /^100[0-7]{3}$/.test(mode)) {
      blobs.push({ oid, path: file2, mode: (parseInt(mode, 8) & 73) !== 0 ? 448 : 384 });
    } else skip("unsafe", file2, `mode ${mode} ${type}`);
  }
  const writer = new BlobWriter(dest, blobs, (entry, code2) => skip("unwritable", entry.path, code2));
  try {
    if (blobs.length > 0) {
      await streamGit(git, ["-C", repoPath, "cat-file", "--batch"], {
        input: blobs.map((b) => `${b.oid}
`).join(""),
        onStdout: (chunk2) => writer.push(chunk2),
        timeoutMs: opts.timeoutMs ?? DEFAULT_SNAPSHOT_TIMEOUT_MS,
        signal: opts.signal
      });
    }
    writer.finish();
  } finally {
    writer.close();
  }
  return {
    format: SNAPSHOT_FORMAT,
    sha,
    source: "objects",
    files: writer.files,
    bytes: writer.bytes,
    skipped,
    ...examples.length ? { skippedExamples: examples } : {}
  };
}
var BlobWriter = class {
  constructor(root, entries, onUnwritable) {
    this.root = root;
    this.entries = entries;
    this.onUnwritable = onUnwritable;
  }
  root;
  entries;
  onUnwritable;
  files = 0;
  bytes = 0;
  index = 0;
  state = "header";
  header = [];
  headerBytes = 0;
  remaining = 0;
  fd = null;
  dirs = /* @__PURE__ */ new Set();
  push(chunk2) {
    let off = 0;
    while (off < chunk2.length) {
      if (this.state === "header") {
        const nl = chunk2.indexOf(10, off);
        const end = nl === -1 ? chunk2.length : nl;
        this.headerBytes += end - off;
        if (this.headerBytes > 1024) throw new Error("git cat-file: malformed output (header line too long)");
        this.header.push(chunk2.subarray(off, end));
        if (nl === -1) return;
        off = nl + 1;
        const line = Buffer.concat(this.header).toString("utf8");
        this.header = [];
        this.headerBytes = 0;
        this.startBlob(line);
      } else if (this.state === "body") {
        const n = Math.min(this.remaining, chunk2.length - off);
        if (this.fd !== null) {
          writeFully(this.fd, chunk2.subarray(off, off + n));
          this.bytes += n;
        }
        off += n;
        this.remaining -= n;
        if (this.remaining === 0) this.endBlob();
      } else {
        if (chunk2[off] !== 10) throw new Error("git cat-file: malformed output (no newline after object)");
        off++;
        this.index++;
        this.state = "header";
      }
    }
  }
  /** Throws unless every requested object was read completely. */
  finish() {
    if (this.index !== this.entries.length || this.state !== "header" || this.headerBytes > 0) {
      throw new Error(`git cat-file: output ended after ${this.index} of ${this.entries.length} objects`);
    }
  }
  close() {
    if (this.fd !== null) (0, import_node_fs2.closeSync)(this.fd);
    this.fd = null;
  }
  startBlob(line) {
    const entry = this.entries[this.index];
    const m = /^([0-9a-f]+) (\S+) (\d+)$/.exec(line);
    if (!entry || !m || m[1] !== entry.oid || m[2] !== "blob") {
      throw new Error(`git cat-file: expected blob ${entry?.oid ?? "(none)"} for ${entry?.path ?? "?"}, got: ${line.slice(0, 200)}`);
    }
    this.remaining = Number(m[3]);
    this.fd = this.open(entry);
    this.state = "body";
    if (this.remaining === 0) this.endBlob();
  }
  endBlob() {
    if (this.fd !== null) {
      (0, import_node_fs2.closeSync)(this.fd);
      this.fd = null;
      this.files++;
    }
    this.state = "newline";
  }
  open(entry) {
    const full = import_node_path2.default.join(this.root, ...entry.path.split("/"));
    try {
      const parent = import_node_path2.default.dirname(full);
      if (!this.dirs.has(parent)) {
        (0, import_node_fs2.mkdirSync)(parent, { recursive: true, mode: 448 });
        this.dirs.add(parent);
      }
      const flags = import_node_fs2.constants.O_WRONLY | import_node_fs2.constants.O_CREAT | import_node_fs2.constants.O_EXCL | import_node_fs2.constants.O_NOFOLLOW;
      return (0, import_node_fs2.openSync)(full, flags, entry.mode);
    } catch (err) {
      const code2 = errCode(err);
      if (code2 && UNWRITABLE_CODES.has(code2)) {
        this.onUnwritable(entry, code2);
        return null;
      }
      throw err;
    }
  }
};
function writeFully(fd, buf) {
  let off = 0;
  while (off < buf.length) off += (0, import_node_fs2.writeSync)(fd, buf, off, buf.length - off);
}
function streamGit(git, args, opts) {
  const what = `git ${args.filter((a) => a !== "-C").slice(1).join(" ")}`;
  return new Promise((resolve, reject) => {
    const child = (0, import_node_child_process2.spawn)(git, args, { env: GIT_ENV, stdio: ["pipe", "pipe", "pipe"] });
    let stderr = "";
    let failure2 = null;
    let settled = false;
    const fail = (err) => {
      failure2 ??= err;
      if (child.exitCode === null && child.signalCode === null) child.kill("SIGKILL");
    };
    const timer = setTimeout(() => fail(new Error(`${what} timed out after ${Math.round(opts.timeoutMs / 1e3)}s`)), opts.timeoutMs);
    const onAbort = () => fail(new Error(`${what} was cancelled`));
    const settle2 = (err) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      opts.signal?.removeEventListener("abort", onAbort);
      if (err) reject(err);
      else resolve();
    };
    if (opts.signal?.aborted) onAbort();
    else opts.signal?.addEventListener("abort", onAbort, { once: true });
    child.stdout.on("data", (chunk2) => {
      if (failure2) return;
      try {
        opts.onStdout(chunk2);
      } catch (err) {
        fail(err instanceof Error ? err : new Error(String(err)));
      }
    });
    child.stderr.setEncoding("utf8");
    child.stderr.on("data", (d) => {
      if (stderr.length < 64 * 1024) stderr += d;
    });
    child.stdin.on("error", () => {
    });
    child.on("error", (err) => settle2(err));
    child.on("close", (code2, signal) => {
      if (failure2) settle2(failure2);
      else if (code2 !== 0) settle2(new Error(`${what} exited ${code2 ?? signal}: ${stderr.trim().slice(0, 2e3)}`));
      else settle2(null);
    });
    child.stdin.end(opts.input);
  });
}
function scrubSnapshot(dir) {
  let entries;
  try {
    entries = (0, import_node_fs2.readdirSync)(dir);
  } catch (err) {
    if (errCode(err) === "ENOENT" || errCode(err) === "ENOTDIR") return;
    throw err;
  }
  for (const entry of entries) {
    const full = import_node_path2.default.join(dir, entry);
    const st = (0, import_node_fs2.lstatSync)(full, { throwIfNoEntry: false });
    if (!st) continue;
    if (isScrubbedName(entry) || st.isSymbolicLink()) (0, import_node_fs2.rmSync)(full, { recursive: true, force: true });
    else if (st.isDirectory()) scrubSnapshot(full);
  }
}

// src/lib/signals/priority.ts
function priorityRank(p) {
  return PRIORITIES.indexOf(p);
}
var atLeast = (value, threshold) => value !== null && value >= threshold;
function formatAgainst(value, marks) {
  const thresholds = typeof marks === "number" ? [marks] : marks;
  for (let digits = 2; digits <= 6; digits++) {
    const rounded = Number(value.toPrecision(digits));
    const sameSide = thresholds.every((m) => rounded >= m === value >= m);
    if (sameSide && Math.trunc(rounded) === Math.trunc(value)) return String(rounded);
  }
  return String(value);
}
var epssMarks = (t) => [t.epss_high, t.epss_medium];
var cvssMarks = (t) => [t.cvss_critical, t.cvss_high];
var kevReason = (dateAdded) => dateAdded ? `in CISA KEV since ${dateAdded.slice(0, 10)}` : "in CISA KEV";
var geReason = (label2, value, threshold, marks) => `${label2} ${formatAgainst(value, marks)} ≥ ${threshold}`;
var ltReason = (label2, value, threshold, marks) => `${label2} ${formatAgainst(value, marks)} < ${threshold}`;
function computeBasePriority(input2, t) {
  const { epss, cvss } = input2;
  const internetFacing = input2.exposure === "internet-facing";
  const highCriticality = input2.criticality === "high";
  const em = epssMarks(t);
  const cm = cvssMarks(t);
  if (input2.malicious) {
    const reasons = [`malicious package (${input2.osvId})`];
    if (input2.inKev) reasons.push(kevReason(input2.kevDateAdded));
    return { priority: "P0", reasons };
  }
  if (input2.inKev && (internetFacing || highCriticality)) {
    const reasons = [kevReason(input2.kevDateAdded)];
    if (internetFacing) reasons.push("asset internet-facing");
    if (highCriticality) reasons.push("criticality high");
    return { priority: "P0", reasons };
  }
  const p1 = [];
  if (input2.inKev) p1.push(kevReason(input2.kevDateAdded));
  if (atLeast(epss, t.epss_high)) p1.push(geReason("EPSS", epss, t.epss_high, em));
  if (internetFacing && atLeast(cvss, t.cvss_critical)) p1.push(`${geReason("CVSS", cvss, t.cvss_critical, cm)} on internet-facing asset`);
  if (p1.length) return { priority: "P1", reasons: p1 };
  const p2 = [];
  if (atLeast(cvss, t.cvss_high)) p2.push(geReason("CVSS", cvss, t.cvss_high, cm));
  if (atLeast(epss, t.epss_medium)) p2.push(geReason("EPSS", epss, t.epss_medium, em));
  if (p2.length) return { priority: "P2", reasons: p2 };
  return { priority: "P3", reasons: p3Reasons(cvss, epss, t) };
}
function p3Reasons(cvss, epss, t) {
  if (cvss === null && epss === null) return ["no CVSS/EPSS signal"];
  return [
    cvss === null ? "no CVSS score" : ltReason("CVSS", cvss, t.cvss_high, cvssMarks(t)),
    epss === null ? "no EPSS score" : ltReason("EPSS", epss, t.epss_medium, epssMarks(t))
  ];
}


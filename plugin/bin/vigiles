function isAssetRoot(dir) {
  return (0, import_node_fs7.existsSync)(import_node_path7.default.join(dir, "config", "policy.yaml")) && (0, import_node_fs7.existsSync)(import_node_path7.default.join(dir, "prompts", "triage"));
}
function findAssetRoot(start, env = process.env) {
  if (env.VIGILES_ASSET_ROOT) {
    const root = import_node_path7.default.resolve(env.VIGILES_ASSET_ROOT);
    if (!isAssetRoot(root)) throw new Error(`VIGILES_ASSET_ROOT=${root} has no config/policy.yaml and prompts/triage`);
    return root;
  }
  let dir = start ?? scriptDir();
  for (; ; ) {
    if (isAssetRoot(dir)) return dir;
    const parent = import_node_path7.default.dirname(dir);
    if (parent === dir) throw new Error(`cannot find the Vigiles assets (config/policy.yaml, prompts/triage) above ${start ?? scriptDir()}`);
    dir = parent;
  }
}
function scriptDir() {
  const entry = process.argv[1];
  if (!entry) return process.cwd();
  try {
    return import_node_path7.default.dirname((0, import_node_fs7.realpathSync)(entry));
  } catch {
    return import_node_path7.default.dirname(import_node_path7.default.resolve(entry));
  }
}
function cacheDir(env = process.env) {
  if (env.VIGILES_CACHE_DIR) return import_node_path7.default.resolve(env.VIGILES_CACHE_DIR);
  if (env.XDG_CACHE_HOME) return import_node_path7.default.join(import_node_path7.default.resolve(env.XDG_CACHE_HOME), "vigiles");
  return import_node_path7.default.join((0, import_node_os.homedir)(), ".cache", "vigiles");
}
function pluginPaths(opts = {}) {
